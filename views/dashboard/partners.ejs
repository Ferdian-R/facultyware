                Menu Utama</h3>
              <ul class="space-y-1">
                <li>
                  <a href="/admin/dashboard"
                    class="flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md hover:bg-accent hover:text-accent-foreground text-muted-foreground">
                    <i data-lucide="layout-dashboard" class="size-4"></i>
                    <span>Dashboard Overview</span>
                  </a>
                </li>
                <li>
                  <a href="/admin/questions"
                    class="flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md hover:bg-accent hover:text-accent-foreground text-muted-foreground">
                    <i data-lucide="help-circle" class="size-4"></i>
                    <span>Pertanyaan Survey</span>
                  </a>
                </li>
                <li>
                  <a href="/admin/partners"
                    class="flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md bg-accent text-accent-foreground">
                    <i data-lucide="building-2" class="size-4 text-foreground"></i>
                    <span>Manajemen Mitra</span>
                  </a>
                </li>
                <li>
                  <a href="/admin/recap-answers"
                    class="flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md hover:bg-accent hover:text-accent-foreground text-muted-foreground">
                    <i data-lucide="bar-chart-3" class="size-4"></i>
                    <span>Hasil Survey</span>
                  </a>
                </li>
              </ul>
            </div>
          </section>
        </div>

        <footer class="p-4 border-t">
          <div id="popover-profile" class="popover w-full">
            <button id="popover-profile-trigger" type="button" aria-expanded="false"
              aria-controls="popover-profile-popover"
              class="flex w-full items-center gap-2 px-3 py-2 rounded-md hover:bg-accent hover:text-accent-foreground justify-start text-left">
              <div
                class="flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 text-primary font-bold text-xs shrink-0">
                AF</div>
              <div class="grid flex-1 text-xs leading-tight">
                <span class="truncate font-semibold text-foreground">
                  <%= user %>
                </span>
                <span class="truncate text-muted-foreground text-[10px]">Administrator</span>
              </div>
              <i data-lucide="chevrons-up-down" class="size-4 text-muted-foreground shrink-0 ml-auto"></i>
            </button>
            <div id="popover-profile-popover" data-popover aria-hidden="true" data-side="top" class="w-[200px]">
              <div class="grid p-1 bg-popover text-popover-foreground border rounded-md shadow-md">
                <a href="/logout"
                  class="flex items-center gap-2 px-2 py-1.5 text-sm text-destructive hover:bg-destructive/10 rounded-sm">
                  <i data-lucide="log-out" class="size-4"></i>
                  <span>Keluar</span>
                </a>
              </div>
            </div>
          </div>
        </footer>
      </nav>
    </aside>

    <!-- Main Content Area -->
    <main id="content" class="flex-1 flex flex-col min-w-0 bg-muted/20">

      <!-- Topbar Header -->
      <header
        class="bg-background sticky inset-x-0 top-0 isolate flex shrink-0 items-center justify-between border-b z-10 h-14 px-4 gap-4" style="z-index: 40;">
        <div class="flex items-center gap-2">
          <button type="button" onclick="document.dispatchEvent(new CustomEvent('basecoat:sidebar'))"
            aria-label="Toggle sidebar"
            class="h-8 w-8 inline-flex items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground md:hidden">
            <i data-lucide="menu" class="size-4"></i>
          </button>
          <h1 class="text-sm font-semibold tracking-tight text-foreground">
            Manajemen Mitra
          </h1>
        </div>

        <div class="flex items-center gap-2">

          <button type="button" aria-label="Toggle dark mode"
            onclick="document.dispatchEvent(new CustomEvent('basecoat:theme'))"
            class="h-8 w-8 inline-flex items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
            <i data-lucide="sun" class="size-4 hidden dark:block"></i>
            <i data-lucide="moon" class="size-4 block dark:hidden"></i>
          </button>
        </div>
      </header>

      <!-- Inner Content -->
      <div class="p-6 md:p-8 flex-1 space-y-6">

        <!-- Alerts -->
        <% if (error) { %>
          <div
            class="bg-destructive/15 text-destructive text-sm p-4 rounded-md border border-destructive/20 flex items-center gap-2">
            <i data-lucide="alert-circle" class="size-4 shrink-0"></i>
            <span>
              <%= error %>
            </span>
          </div>
          <% } %>
            <% if (success) { %>
              <div
                class="bg-emerald-500/10 text-emerald-500 text-sm p-4 rounded-md border border-emerald-500/20 flex items-center gap-2">
                <i data-lucide="check-circle-2" class="size-4 shrink-0"></i>
                <span>
                  <%= success %>
                </span>
              </div>
              <% } %>

                <!-- Stats Grid -->
                <div class="dashboard-grid gap-4">

                  <!-- Card 1: Total -->
                  <div data-slot="card" class="premium-card rounded-2xl p-6 flex flex-col justify-between gap-5">
                    <div class="flex items-start gap-4">
                      <div class="p-3 bg-indigo-500/10 rounded-2xl text-indigo-600 dark:text-indigo-400 border border-indigo-500/15 shrink-0">
                        <i data-lucide="building-2" class="size-5"></i>
                      </div>
                      <div class="space-y-1">
                        <p class="card-title-small">Total Mitra</p>
                        <h3 class="text-3xl font-extrabold tracking-tight text-foreground"><%= stats.total %></h3>
                        <span class="card-subtext block mt-0.5">
                          Instansi terdaftar
                        </span>
                      </div>
                    </div>
                    <div class="card-divider">
                      <div class="flex justify-between items-center text-[10px] font-bold text-muted-foreground">
                        <span>Keaktifan Mitra</span>
                        <span class="text-foreground"><%= stats.total > 0 ? Math.round((stats.active / stats.total) * 100) : 0 %>%</span>
                      </div>
                      <div class="custom-progress-track">
                        <div class="custom-progress-fill indigo" style="width: <%= stats.total > 0 ? Math.round((stats.active / stats.total) * 100) : 0 %>%"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Card 2: Active -->
                  <div data-slot="card" class="premium-card rounded-2xl p-6 flex flex-col justify-between gap-5">
                    <div class="flex items-start gap-4">
                      <div class="p-3 bg-emerald-500/10 rounded-2xl text-emerald-600 dark:text-emerald-400 border border-emerald-500/15 shrink-0">
                        <i data-lucide="check-circle" class="size-5"></i>
                      </div>
                      <div class="space-y-1">
                        <p class="card-title-small">Mitra Akses</p>
                        <h3 class="text-3xl font-extrabold tracking-tight text-foreground"><%= stats.active %></h3>
                        <span class="card-subtext block mt-0.5">
                          Kerja sama aktif
                        </span>
                      </div>
                    </div>
                    <div class="card-divider">
                      <div class="flex justify-between items-center text-[10px] font-bold text-muted-foreground">
                        <span>Rasio Aktif</span>
                        <span class="text-foreground"><%= stats.total > 0 ? Math.round((stats.active / stats.total) * 100) : 0 %>%</span>
                      </div>
                      <div class="custom-progress-track">
                        <div class="custom-progress-fill emerald" style="width: <%= stats.total > 0 ? Math.round((stats.active / stats.total) * 100) : 0 %>%"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Card 3: Inactive -->
                  <div data-slot="card" class="premium-card rounded-2xl p-6 flex flex-col justify-between gap-5">
                    <div class="flex items-start gap-4">
                      <div class="p-3 bg-red-500/10 rounded-2xl text-red-600 dark:text-red-400 border border-red-500/15 shrink-0">
                        <i data-lucide="alert-triangle" class="size-5"></i>
                      </div>
                      <div class="space-y-1">
                        <p class="card-title-small">Mitra Non-Aktif</p>
                        <h3 class="text-3xl font-extrabold tracking-tight text-foreground"><%= stats.inactive %></h3>
                        <span class="card-subtext block mt-0.5">
                          Ditangguhkan / off
                        </span>
                      </div>
                    </div>
                    <div class="card-divider">
                      <div class="flex justify-between items-center text-[10px] font-bold text-muted-foreground">
                        <span>Rasio Non-Aktif</span>
                        <span class="text-foreground"><%= stats.total > 0 ? Math.round((stats.inactive / stats.total) * 100) : 0 %>%</span>
                      </div>
                      <div class="custom-progress-track">
                        <div class="custom-progress-fill red" style="width: <%= stats.total > 0 ? Math.round((stats.inactive / stats.total) * 100) : 0 %>%"></div>
                      </div>
                    </div>
                  </div>

                </div>

                <!-- Filters and Data Table Card -->
                <div data-slot="card" class="premium-card rounded-2xl overflow-hidden">
                  <div class="p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b">
                    <form method="GET" action="/admin/partners"
                      class="flex flex-wrap items-center gap-2 w-full md:w-auto">
                      <label class="relative flex items-center flex-1 md:flex-initial">
                        <i data-lucide="search" class="text-muted-foreground" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); width: 15px; height: 15px; pointer-events: none;"></i>
                        <input type="text" name="search" placeholder="Cari nama/email..." value="<%= search %>"
                          style="padding-left: 36px;"
                          class="h-9 rounded-md border border-border bg-background/60 hover:bg-background/80 focus:bg-background text-sm w-full md:w-56 outline-none focus-visible:ring-1 focus-visible:ring-primary transition-all" />
                      </label>

                      <select name="type"
                        class="h-9 rounded-md border text-xs premium-select outline-none focus-visible:ring-1 focus-visible:ring-ring"
                        onchange="this.form.submit()">
                        <option value="">-- Semua Tipe --</option>
                        <option value="university" <%=selectedType==='university' ? 'selected' : '' %>>Perguruan Tinggi
                        </option>
                        <option value="company" <%=selectedType==='company' ? 'selected' : '' %>>Swasta/Perusahaan
                        </option>
                        <option value="government" <%=selectedType==='government' ? 'selected' : '' %>>Pemerintah
                        </option>
                        <option value="ngo" <%=selectedType==='ngo' ? 'selected' : '' %>>NGO/LSM</option>
                        <option value="other" <%=selectedType==='other' ? 'selected' : '' %>>Lainnya</option>
                      </select>

                      <select name="status"
                        class="h-9 rounded-md border text-xs premium-select outline-none focus-visible:ring-1 focus-visible:ring-ring"
                        onchange="this.form.submit()">
                        <option value="">-- Semua Status --</option>
                        <option value="active" <%=selectedStatus==='active' ? 'selected' : '' %>>Aktif</option>
                        <option value="inactive" <%=selectedStatus==='inactive' ? 'selected' : '' %>>Non-Aktif</option>
                      </select>

                      <% if (search || selectedType || selectedStatus) { %>
                        <a href="/admin/partners"
                          class="h-9 w-9 inline-flex items-center justify-center rounded-md border hover:bg-accent hover:text-accent-foreground text-muted-foreground"
                          title="Reset Filter">
                          <i data-lucide="x" class="size-4"></i>
                        </a>
                        <% } %>
                    </form>

                    <div class="w-full md:w-auto text-right">
                      <button id="btn-add-partner"
                        class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-3 py-2 w-full md:w-auto">
                        <i data-lucide="plus-circle" class="size-4"></i>
                        <span>Tambah Mitra</span>
                      </button>
                    </div>
                  </div>

                  <div class="overflow-x-auto w-full">
                    <table class="w-full text-sm">
                      <thead class="bg-muted/50 border-b">
                        <tr class="transition-colors hover:bg-muted/50">
                          <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">
                            Perusahaan/Instansi Mitra</th>
                          <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Tipe</th>
                          <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Kontak Resmi
                          </th>
                          <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Status</th>
                          <th class="h-10 px-4 text-center align-middle font-medium text-muted-foreground w-32">Aksi
                          </th>
                        </tr>
                      </thead>
                      <tbody class="divide-y">
                        <% if (locals.partners && partners.length> 0) { %>
                          <% partners.forEach(function(p) { const avatarStr=p.name.substring(0, 2).toUpperCase(); let
                            typeBadgeClass='bg-slate-500/10 text-slate-500 border-slate-500/20' ; let typeText='Lainnya'
                            ; if (p.type==='university' ) {
                            typeBadgeClass='bg-blue-500/10 text-blue-500 border-blue-500/20' ;
                            typeText='Univ / Akademik' ; } else if (p.type==='company' ) {
                            typeBadgeClass='bg-sky-500/10 text-sky-500 border-sky-500/20' ; typeText='Swasta / Bisnis' ;
                            } else if (p.type==='government' ) {
                            typeBadgeClass='bg-amber-500/10 text-amber-500 border-amber-500/20' ;
                            typeText='Pemerintah / BUMN' ; } else if (p.type==='ngo' ) {
                            typeBadgeClass='bg-emerald-500/10 text-emerald-500 border-emerald-500/20' ;
                            typeText='NGO / LSM' ; } %>
                            <tr id="row-partner-<%= p.id %>" class="hover:bg-muted/30 transition-colors">
                              <td class="p-4 align-middle font-medium">
                                <div class="flex items-center gap-3">
                                  <div
                                    class="flex h-9 w-9 items-center justify-center rounded-full bg-muted text-muted-foreground text-xs font-bold">
                                    <%= avatarStr %>
                                  </div>
                                  <div>
                                    <div class="text-foreground">
                                      <%= p.name %>
                                    </div>
                                    <div class="text-xs text-muted-foreground font-normal">#MITRA-<%=
                                        p.id.toString().padStart(3, '0' ) %>
                                    </div>
                                  </div>
                                </div>
                              </td>
                              <td class="p-4 align-middle">
                                <span
                                  class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold <%= typeBadgeClass %>">
                                  <%= typeText %>
                                </span>
                              </td>
                              <td class="p-4 align-middle">
                                <div class="text-xs text-muted-foreground space-y-1">
                                  <div class="flex items-center gap-1"><i data-lucide="mail" class="size-3"></i>
                                    <%= p.email || '—' %>
                                  </div>
                                  <div class="flex items-center gap-1"><i data-lucide="phone" class="size-3"></i>
                                    <%= p.phone || '—' %>
                                  </div>
                                </div>
                              </td>
                              <td class="p-4 align-middle">
                                <span
                                  class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold <%= p.status === 'active' ? 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20' : 'bg-red-500/10 text-red-500 border-red-500/20' %>">
                                  <%= p.status==='active' ? 'Aktif' : 'Non-Aktif' %>
                                </span>
                              </td>
                              <td class="p-4 align-middle text-center">
                                <div class="flex items-center justify-center gap-2">
                                  <a href="/admin/partners/<%= p.id %>"
                                    class="h-8 w-8 inline-flex items-center justify-center rounded-md border hover:bg-accent hover:text-accent-foreground text-muted-foreground"
                                    title="Lihat Profil Detail">
                                    <i data-lucide="eye" class="size-3.5"></i>
                                  </a>
                                  <button
                                    class="btn-edit-partner h-8 w-8 inline-flex items-center justify-center rounded-md border hover:bg-accent hover:text-accent-foreground text-muted-foreground"
                                    data-id="<%= p.id %>" data-name="<%= p.name %>" data-type="<%= p.type %>"
                                    data-email="<%= p.email %>" data-phone="<%= p.phone %>"
                                    data-address="<%= p.address %>" data-description="<%= p.description %>"
                                    data-status="<%= p.status %>" title="Ubah Profil">
                                    <i data-lucide="edit-3" class="size-3.5"></i>
                                  </button>
                                  <button
                                    class="h-8 w-8 inline-flex items-center justify-center rounded-md border border-destructive/20 hover:bg-destructive/10 text-destructive"
                                    hx-delete="/admin/partners/<%= p.id %>"
                                    hx-confirm="Apakah Anda yakin ingin menghapus data mitra ini beserta seluruh data kontak & riwayat survey terkait secara permanen?"
                                    hx-target="#row-partner-<%= p.id %>" hx-swap="outerHTML" title="Hapus Mitra">
                                    <i data-lucide="trash-2" class="size-3.5"></i>
                                  </button>
                                </div>
                              </td>
                            </tr>
                            <% }); %>
                              <% } else { %>
                                <tr>
                                  <td colspan="5" class="p-8 text-center text-muted-foreground">
                                    <i data-lucide="building-2"
                                      class="size-8 mx-auto stroke-1 text-muted-foreground/50 mb-2"></i>
                                    <div>Belum ada data mitra terdaftar. Klik tombol Tambah Mitra untuk membuat baru.
                                    </div>
                                  </td>
                                </tr>
                                <% } %>
                      </tbody>
                    </table>
                  </div>

                  <!-- Pagination Footer -->
                  <% if (locals.totalPages && totalPages> 1) { %>
                    <div class="p-4 flex flex-col sm:flex-row justify-between items-center gap-4 border-t bg-muted/20">
                      <div class="text-xs text-muted-foreground">
                        Menampilkan halaman <strong>
                          <%= page %>
                        </strong> dari <strong>
                          <%= totalPages %>
                        </strong> (Total: <%= totalItems %> mitra)
                      </div>
                      <div class="flex gap-1" style="display: flex; gap: 4px;">
                        <% if (page> 1) { %>
                          <a href="?search=<%= search %>&type=<%= selectedType %>&status=<%= selectedStatus %>&page=<%= page - 1 %>"
                            style="width: 32px; min-width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;"
                            class="rounded-md border hover:bg-accent hover:text-accent-foreground text-muted-foreground"><i
                              data-lucide="chevron-left" class="size-4"></i></a>
                          <% } else { %>
                            <span
                              style="width: 32px; min-width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;"
                              class="rounded-md border opacity-50 cursor-not-allowed text-muted-foreground"><i
                                data-lucide="chevron-left" class="size-4"></i></span>
                            <% } %>

                              <% for(let i=1; i <=totalPages; i++) { %>
                                <a href="?search=<%= search %>&type=<%= selectedType %>&status=<%= selectedStatus %>&page=<%= i %>"
                                  style="width: 32px; min-width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;"
                                  class="rounded-md border text-sm <%= page === i ? 'bg-primary text-primary-foreground font-semibold border-primary' : 'hover:bg-accent hover:text-accent-foreground text-muted-foreground' %>">
                                  <%= i %>
                                </a>
                                <% } %>

                                  <% if (page < totalPages) { %>
                                    <a href="?search=<%= search %>&type=<%= selectedType %>&status=<%= selectedStatus %>&page=<%= page + 1 %>"
                                      style="width: 32px; min-width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;"
                                      class="rounded-md border hover:bg-accent hover:text-accent-foreground text-muted-foreground"><i
                                        data-lucide="chevron-right" class="size-4"></i></a>
                                    <% } else { %>
                                      <span
                                        style="width: 32px; min-width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;"
                                        class="rounded-md border opacity-50 cursor-not-allowed text-muted-foreground"><i
                                          data-lucide="chevron-right" class="size-4"></i></span>
                                      <% } %>
                      </div>
                    </div>
                    <% } %>
                </div>

      </div>
    </main>
  </div>

  <!-- Tambah Mitra Dialog Modal -->
  <dialog id="add-dialog" class="dialog">
    <div class="!max-w-lg w-full max-h-[85vh] overflow-y-auto pr-1">
      <div class="flex items-center gap-2 border-b pb-3">
        <div class="p-2 bg-primary/10 text-primary rounded-lg">
          <i data-lucide="building-2" class="size-5"></i>
        </div>
        <div>
          <h3 class="text-lg font-semibold leading-none tracking-tight">Tambah Mitra Baru</h3>
          <p class="text-xs text-muted-foreground mt-1">Inisialisasi akun mitra kerjasama beserta data narahubung utama.
          </p>
        </div>
      </div>

      <form action="/admin/partners" method="POST" id="form-add-partner" class="flex flex-col gap-4">
        <div class="grid grid-cols-2 gap-4">
          <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider col-span-2 border-b pb-1">
            Profil Perusahaan</div>

          <div class="flex flex-col gap-2 col-span-2">
            <label class="text-sm font-medium leading-none" for="add-name">Nama Instansi / Perusahaan</label>
            <input type="text" id="add-name" name="name"
              class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
              placeholder="Misal: PT Teknologi Maju Indonesia" required />
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-sm font-medium leading-none" for="add-type">Tipe Kemitraan</label>
            <select id="add-type" name="type"
              class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
              required>
              <option value="" disabled selected>-- Pilih Tipe --</option>
              <option value="university">Perguruan Tinggi</option>
              <option value="company">Swasta / Perusahaan</option>
              <option value="government">Instansi Pemerintah</option>
              <option value="ngo">NGO / LSM</option>
              <option value="other">Lainnya</option>
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-sm font-medium leading-none" for="add-status">Status Akun</label>
            <select id="add-status" name="status"
              class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
              required>
              <option value="active" selected>Aktif</option>
              <option value="inactive">Non-Aktif</option>
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-sm font-medium leading-none" for="add-email">Email Resmi</label>
            <input type="email" id="add-email" name="email"
              class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
              placeholder="info@perusahaan.com" />
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-sm font-medium leading-none" for="add-phone">Nomor Telepon</label>
            <input type="text" id="add-phone" name="phone"
              class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
              placeholder="021-xxxxxxxx" />
          </div>

          <div class="flex flex-col gap-2 col-span-2">
            <label class="text-sm font-medium leading-none" for="add-address">Alamat Lengkap</label>
            <textarea id="add-address" name="address"
              class="flex min-h-[60px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
              placeholder="Alamat kantor pusat..."></textarea>
          </div>

          <div class="flex flex-col gap-2 col-span-2">
            <label class="text-sm font-medium leading-none" for="add-description">Deskripsi Singkat Kerja Sama</label>
            <textarea id="add-description" name="description"
              class="flex min-h-[60px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
              placeholder="Detail fokus kerjasama kependidikan..."></textarea>
          </div>

          <div
            class="text-xs font-semibold text-muted-foreground uppercase tracking-wider col-span-2 border-b pb-1 mt-2">
            Narahubung Utama (Primary Contact)</div>

          <div class="flex flex-col gap-2 col-span-2">
            <label class="text-sm font-medium leading-none" for="add-contact-name">Nama Narahubung Utama</label>
            <input type="text" id="add-contact-name" name="contact_name"
              class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
              placeholder="Nama lengkap perwakilan mitra" required />
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-sm font-medium leading-none" for="add-contact-position">Jabatan</label>
            <input type="text" id="add-contact-position" name="contact_position"
              class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
              placeholder="Misal: HRD Manager" required />
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-sm font-medium leading-none" for="add-contact-phone">No HP / WhatsApp</label>
            <input type="text" id="add-contact-phone" name="contact_phone"
              class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
              placeholder="08xxxxxxxxxx" />
          </div>

          <div class="flex flex-col gap-2 col-span-2">
            <label class="text-sm font-medium leading-none" for="add-contact-email">Email Kontak</label>
            <input type="email" id="add-contact-email" name="contact_email"
              class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
              placeholder="kontak@perusahaan.com" />
          </div>
        </div>

        <div class="flex justify-end gap-2 border-t pt-3 mt-2">
          <button type="button" id="btn-close-add"
            class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
            Batal
          </button>
          <button type="submit"
            class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2">
            Simpan Kemitraan
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Ubah Mitra Dialog Modal -->
  <dialog id="edit-dialog" class="dialog">
    <div class="!max-w-lg w-full max-h-[85vh] overflow-y-auto pr-1">
      <div class="flex items-center gap-2 border-b pb-3">
        <div class="p-2 bg-primary/10 text-primary rounded-lg">
          <i data-lucide="edit-3" class="size-5"></i>
        </div>
        <div>
          <h3 class="text-lg font-semibold leading-none tracking-tight">Ubah Profil Mitra</h3>
          <p class="text-xs text-muted-foreground mt-1">Perbarui rincian data profil dan legalitas perusahaan mitra
            terdaftar.</p>
        </div>
      </div>

      <form id="form-edit-partner" method="POST" class="flex flex-col gap-4">
        <div class="grid grid-cols-2 gap-4">
          <div class="flex flex-col gap-2 col-span-2">
            <label class="text-sm font-medium leading-none" for="edit-name">Nama Instansi / Perusahaan</label>
            <input type="text" id="edit-name" name="name"
              class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
              required />
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-sm font-medium leading-none" for="edit-type">Tipe Kemitraan</label>
            <select id="edit-type" name="type"
              class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
              required>
              <option value="university">Perguruan Tinggi</option>
              <option value="company">Swasta / Perusahaan</option>
              <option value="government">Instansi Pemerintah</option>
              <option value="ngo">NGO / LSM</option>
              <option value="other">Lainnya</option>
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-sm font-medium leading-none" for="edit-status">Status Akun</label>
            <select id="edit-status" name="status"
              class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
              required>
              <option value="active">Aktif</option>
              <option value="inactive">Non-Aktif</option>
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-sm font-medium leading-none" for="edit-email">Email Resmi</label>
            <input type="email" id="edit-email" name="email"
              class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-sm font-medium leading-none" for="edit-phone">Nomor Telepon</label>
            <input type="text" id="edit-phone" name="phone"
              class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
          </div>

          <div class="flex flex-col gap-2 col-span-2">
            <label class="text-sm font-medium leading-none" for="edit-address">Alamat Lengkap</label>
            <textarea id="edit-address" name="address"
              class="flex min-h-[60px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
          </div>

          <div class="flex flex-col gap-2 col-span-2">
            <label class="text-sm font-medium leading-none" for="edit-description">Deskripsi Singkat Kerja Sama</label>
            <textarea id="edit-description" name="description"
              class="flex min-h-[60px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
          </div>
        </div>

        <div class="flex justify-end gap-2 border-t pt-3 mt-2">
          <button type="button" id="btn-close-edit"
            class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
            Batal
          </button>
          <button type="submit"
            class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2">
            Simpan Perubahan
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <script>
    lucide.createIcons();

    // Modal dialogue Forms Logic
    const addDialog = document.getElementById('add-dialog');
    const editDialog = document.getElementById('edit-dialog');

    const btnAddPartner = document.getElementById('btn-add-partner');
    const btnCloseAdd = document.getElementById('btn-close-add');
    const btnCloseEdit = document.getElementById('btn-close-edit');

    const formEditPartner = document.getElementById('form-edit-partner');

    if (btnAddPartner) {
      btnAddPartner.addEventListener('click', () => {
        addDialog.showModal();
      });
    }

    btnCloseAdd.addEventListener('click', () => {
      addDialog.close();
    });

    document.querySelectorAll('.btn-edit-partner').forEach(btn => {
      btn.addEventListener('click', function () {
        const id = this.getAttribute('data-id');
        const name = this.getAttribute('data-name');
        const type = this.getAttribute('data-type');
        const email = this.getAttribute('data-email');
        const phone = this.getAttribute('data-phone');
        const address = this.getAttribute('data-address');
        const description = this.getAttribute('data-description');
        const status = this.getAttribute('data-status');

        formEditPartner.action = `/admin/partners/${id}/update`;

        document.getElementById('edit-name').value = name || '';
        document.getElementById('edit-type').value = type || 'company';
        document.getElementById('edit-status').value = status || 'active';
        document.getElementById('edit-email').value = email === 'null' || !email ? '' : email;
        document.getElementById('edit-phone').value = phone === 'null' || !phone ? '' : phone;
        document.getElementById('edit-address').value = address === 'null' || !address ? '' : address;
        document.getElementById('edit-description').value = description === 'null' || !description ? '' : description;

        editDialog.showModal();
      });
    });

    btnCloseEdit.addEventListener('click', () => {
      editDialog.close();
    });

    document.body.addEventListener('htmx:afterOnLoad', function (evt) {
      if (evt.detail.requestConfig.method === 'DELETE' && evt.detail.requestConfig.path.includes('/admin/partners/')) {
        alert('Data mitra berhasil dihapus secara permanen dari sistem!');
        window.location.reload();
      }
    });
  </script>
</body>

</html>
