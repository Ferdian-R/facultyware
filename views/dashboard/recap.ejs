<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <!-- Basecoat UI -->
  <link rel="stylesheet" href="https://unpkg.com/basecoat-css@latest/dist/basecoat.min.css" />
  <!-- Dashboard CSS -->
  <link rel="stylesheet" href="/assets/dashboard.css" />
</head>
<body>

<div class="app-shell">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar__brand">
      <img src="/image/fti logo.jpg" alt="Logo FTI" class="sidebar__logo" onerror="this.style.display='none'" />
      <div>
        <div class="sidebar__wordmark">SUKAFTI</div>
        <div class="sidebar__tagline">Survey Kerjasama FTI</div>
      </div>
    </div>

    <div class="nav-section-label">Menu Utama</div>
    <ul class="nav-list">
      <li class="nav-item">
        <a href="/admin/dashboard" id="nav-dashboard">
          <i data-lucide="layout-dashboard"></i>Dashboard
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/questions" id="nav-questions">
          <i data-lucide="help-circle"></i>Pertanyaan Survey
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/partners" id="nav-mitra">
          <i data-lucide="building-2"></i>Manajemen Mitra
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/recap-answers" class="active" id="nav-hasil">
          <i data-lucide="bar-chart-3"></i>Hasil Survey
        </a>
      </li>
    </ul>

    <div class="sidebar__footer">
      <a href="/logout" id="btn-logout"><i data-lucide="log-out"></i>Keluar</a>
    </div>
  </aside>

  <!-- MAIN WRAPPER -->
  <div class="main-wrapper">

    <!-- TOPBAR -->
    <header class="topbar">
      <div class="topbar__left">
        <h2>Hasil Survey</h2>
        <p>Rekapitulasi tanggapan dan jawaban evaluasi mitra</p>
      </div>
      <div class="topbar__right">
        <div class="admin-chip" id="admin-chip">
          <div class="admin-avatar">AF</div>
          <span class="admin-chip__name"><%= user %></span>
        </div>
      </div>
    </header>

    <!-- CONTENT AREA -->
    <main class="content-area">

      <!-- TABLE CARD -->
      <div class="table-card">
        <div class="table-card__header" style="flex-wrap: wrap; gap: 1rem; align-items: center;">
          <div>
            <h2>Tabel Rekapitulasi Respon Kuesioner</h2>
            <p>Jawaban hasil pengisian survei dari seluruh mitra FTI</p>
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:center;">
            <div style="position:relative; width: 15rem;">
              <i data-lucide="search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; color: #94a3b8;"></i>
              <input type="text" id="topbar-search" placeholder="Cari nama mitra/survey..." value="<%= search %>" autocomplete="off" style="width:100%; padding:0.5rem 1rem 0.5rem 2.4rem; border:1px solid #cbd5e1; border-radius:999px; font-size:0.85rem; outline:none; background:#f8fafc;" />
            </div>

            <a href="/admin/recap-answers/export-excel" class="btn" style="background-color:#10b981; color:white; padding:0.5rem 1rem; border-radius:6px; text-decoration:none; font-size:0.875rem; display:flex; align-items:center; gap:0.5rem;">
              <i data-lucide="file-spreadsheet" style="width:16px; height:16px;"></i> Ekspor Excel
            </a>
          </div>
        </div>

        <div style="overflow-x:auto;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Nama Perusahaan Mitra</th>
                <th>Judul Survei Kemitraan</th>
                <th style="text-align:center; width: 120px;">Total Skor</th>
                <th>Tanggal Pengisian</th>
                <th style="text-align:center; width: 100px;">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% if (locals.responses && responses.length > 0) { %>
                <% responses.forEach(function(r) { 
                     const avatarStr = r.partner_name.substring(0, 2).toUpperCase();
                     let formattedDate = "—";
                     if (r.submitted_at) {
                         const dateObj = new Date(r.submitted_at);
                         const d = dateObj.getDate().toString().padStart(2, '0');
                         const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Ags', 'Sep', 'Okt', 'Nov', 'Des'];
                         const m = months[dateObj.getMonth()];
                         const y = dateObj.getFullYear();
                         const hrs = dateObj.getHours().toString().padStart(2, '0');
                         const mins = dateObj.getMinutes().toString().padStart(2, '0');
                         formattedDate = `${d} ${m} ${y} ${hrs}:${mins}`;
                     }
                %>
                <tr>
                  <td>
                    <div class="company-cell">
                      <div class="company-avatar" style="background:#f1f5f9;color:#1e293b;"><%= avatarStr %></div>
                      <div class="company-name" style="font-weight:700;"><%= r.partner_name %></div>
                    </div>
                  </td>
                  <td style="font-weight:500; color:#475569;"><%= r.survey_title %></td>
                  <td style="text-align:center;">
                    <span class="pill" style="background:#e0f2fe; color:#0369a1; font-weight:700; font-size:0.75rem;"><%= r.score_total %> Poin</span>
                  </td>
                  <td><%= formattedDate %></td>
                  <td style="text-align:center;">
                    <button class="action-btn btn-view-detail" data-id="<%= r.id %>" style="display:inline-flex; align-items:center; gap:4px; font-size:0.75rem; border:1px solid #cbd5e1; padding:0.25rem 0.5rem; border-radius:6px; background:#ffffff; color:#334155; cursor:pointer;">
                      <i data-lucide="eye" style="width:14px; height:14px;"></i> Detail
                    </button>
                  </td>
                </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" style="text-align:center; color:#94a3b8; padding:3rem;">Belum ada kuesioner yang diselesaikan oleh mitra.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <% if (locals.totalPages && totalPages > 1) { %>
          <div style="padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e2e8f0; font-size: 0.8125rem;">
            <div style="color: #64748b;">
              Halaman <strong><%= page %></strong> dari <strong><%= totalPages %></strong> (Total: <%= totalItems %> data)
            </div>
            <div style="display: flex; gap: 4px;">
              <% if (page > 1) { %>
                <a href="?search=<%= search %>&page=<%= page - 1 %>" class="btn" style="border: 1px solid #cbd5e1; padding: 0.25rem 0.5rem; border-radius: 4px; text-decoration: none; color: #334155;">Sebelumnya</a>
              <% } %>
              <% for(let i = 1; i <= totalPages; i++) { %>
                <a href="?search=<%= search %>&page=<%= i %>" class="btn" style="border: 1px solid <%= page === i ? '#1e293b' : '#cbd5e1' %>; background-color: <%= page === i ? '#1e293b' : 'white' %>; color: <%= page === i ? 'white' : '#334155' %>; padding: 0.25rem 0.5rem; border-radius: 4px; text-decoration: none;"><%= i %></a>
              <% } %>
              <% if (page < totalPages) { %>
                <a href="?search=<%= search %>&page=<%= page + 1 %>" class="btn" style="border: 1px solid #cbd5e1; padding: 0.25rem 0.5rem; border-radius: 4px; text-decoration: none; color: #334155;">Selanjutnya</a>
              <% } %>
            </div>
          </div>
        <% } %>
      </div><!-- /.table-card -->

    </main><!-- /.content-area -->
  </div><!-- /.main-wrapper -->
</div><!-- /.app-shell -->

<!-- Detail Dialog Styles -->
<style>
  dialog::backdrop {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
  }
  dialog {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    padding: 2rem;
    border: none;
    border-radius: 12px;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
    max-width: 600px;
    width: 90%;
    background: #ffffff;
    max-height: 85vh;
    overflow-y: auto;
  }
  .meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: #64748b;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 1rem;
    background: #f8fafc;
    margin-bottom: 1.25rem;
  }
  .meta-grid strong {
    color: #1e293b;
  }
  .answer-card {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    background: #ffffff;
    border-left: 4px solid #1e293b;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>

<!-- Detail Dialog -->
<dialog id="detail-dialog">
  <div class="dialog-header">
    <i data-lucide="file-text" style="color:#0f172a;"></i>
    <h3 style="margin:0; font-size: 1.25rem; color: #0f172a;">Rincian Jawaban Kuesioner</h3>
  </div>
  <p style="color:#64748b; margin-bottom:1rem; font-size:0.8125rem; line-height:1.4;">Jawaban mentah yang diserahkan oleh mitra perusahaan.</p>

  <div class="meta-grid">
    <div><strong>Mitra Perusahaan:</strong> <span id="lbl-detail-partner">...</span></div>
    <div><strong>Judul Kuesioner:</strong> <span id="lbl-detail-survey">...</span></div>
    <div><strong>Tanggal Kirim:</strong> <span id="lbl-detail-date">...</span></div>
    <div><strong>Total Nilai:</strong> <span id="lbl-detail-score" style="font-weight:700;">...</span></div>
  </div>

  <div id="detail-loading" style="text-align:center; padding:2rem; color:#94a3b8; font-size:0.875rem;">Memuat rincian data...</div>
  <div id="detail-answers-list" style="display:none; flex-direction:column; gap:12px;"></div>

  <div style="display:flex; justify-content:flex-end; border-top: 1px solid #e2e8f0; padding-top: 1rem; margin-top: 1.25rem;">
    <button type="button" id="btn-close-detail" class="btn" style="border:1px solid #cbd5e1; padding:0.5rem 1rem; border-radius:6px; background:transparent; cursor:pointer;">Tutup</button>
  </div>
</dialog>

<script>
  lucide.createIcons();

  document.getElementById('topbar-search').addEventListener('keypress', function (e) {
    if (e.key === 'Enter') {
      window.location.href = '?search=' + encodeURIComponent(this.value);
    }
  });

  const detailDialog = document.getElementById('detail-dialog');
  const btnCloseDetail = document.getElementById('btn-close-detail');

  const lblPartner = document.getElementById('lbl-detail-partner');
  const lblSurvey = document.getElementById('lbl-detail-survey');
  const lblDate = document.getElementById('lbl-detail-date');
  const lblScore = document.getElementById('lbl-detail-score');

  const loadingBlock = document.getElementById('detail-loading');
  const answersList = document.getElementById('detail-answers-list');

  document.querySelectorAll('.btn-view-detail').forEach(btn => {
    btn.addEventListener('click', function () {
      const id = this.getAttribute('data-id');

      loadingBlock.style.display = 'block';
      answersList.style.display = 'none';
      answersList.innerHTML = '';

      detailDialog.showModal();

      fetch(`/admin/recap-answers/${id}/json`)
        .then(res => res.json())
        .then(res => {
          if (res.success) {
            const data = res.data;

            lblPartner.innerText = data.response.partner_name;
            lblSurvey.innerText = data.response.survey_title;
            lblScore.innerText = data.response.score_total + ' Poin';

            const dateObj = new Date(data.response.submitted_at);
            lblDate.innerText = dateObj.toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) + ' ' + dateObj.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });

            data.answers.forEach((ans, index) => {
              const item = document.createElement('div');
              item.className = 'answer-card';

              const qHeader = document.createElement('div');
              qHeader.style.cssText = 'display:flex; justify-content:space-between; align-items:center; border-bottom: 1px solid #f1f5f9; padding-bottom:4px; font-size:0.7rem; color:#94a3b8; font-weight:700;';
              
              const qNum = document.createElement('span');
              qNum.innerText = `PERTANYAAN ${ans.order_number || (index + 1)}`;
              qHeader.appendChild(qNum);

              if (ans.question_type !== 'essay' && ans.question_type !== 'short_answer') {
                const qScore = document.createElement('span');
                qScore.className = 'pill';
                qScore.style.cssText = 'background:#d1fae5; color:#065f46; font-size:0.65rem; padding:0.1rem 0.4rem;';
                qScore.innerText = `Skor: ${ans.score}`;
                qHeader.appendChild(qScore);
              } else {
                const qScore = document.createElement('span');
                qScore.className = 'pill';
                qScore.style.cssText = 'background:#f1f5f9; color:#475569; font-size:0.65rem; padding:0.1rem 0.4rem;';
                qScore.innerText = 'Essay';
                qHeader.appendChild(qScore);
              }
              item.appendChild(qHeader);

              const qText = document.createElement('div');
              qText.style.cssText = 'font-weight:700; color:#1e293b; font-size:0.875rem; line-height:1.4;';
              qText.innerText = ans.question_text;
              item.appendChild(qText);

              const answerTextVal = (ans.question_type === 'essay' || ans.question_type === 'short_answer')
                ? (ans.answer_text || '— Tidak diisi —')
                : ans.option_text || '—';

              const ansLabel = document.createElement('div');
              ansLabel.style.cssText = 'font-size:0.7rem; color:#94a3b8; font-weight:600; margin-top:4px;';
              ansLabel.innerText = 'Jawaban Anda:';
              item.appendChild(ansLabel);

              const ansContent = document.createElement('div');
              if (ans.question_type === 'essay' || ans.question_type === 'short_answer') {
                ansContent.style.cssText = 'font-size:0.75rem; color:#334155; font-style:italic; background:#f8fafc; border:1px solid #cbd5e1; border-radius:6px; padding:0.5rem; white-space:pre-wrap; line-height:1.4;';
              } else {
                ansContent.style.cssText = 'font-size:0.8125rem; color:#1e293b; font-weight:700; display:flex; align-items:center; gap:4px;';
                ansContent.innerHTML = '<i data-lucide="check-circle-2" style="width:14px; height:14px; color:#10b981;"></i> <span>' + answerTextVal + '</span>';
              }
              ansContent.innerText = answerTextVal;
              item.appendChild(ansContent);

              answersList.appendChild(item);
            });

            loadingBlock.style.display = 'none';
            answersList.style.display = 'flex';
            lucide.createIcons();
          } else {
            loadingBlock.innerHTML = `<p style="color:#ef4444;">Gagal memuat detail: ${res.message}</p>`;
          }
        })
        .catch(err => {
          loadingBlock.innerHTML = '<p style="color:#ef4444;">Terjadi kesalahan sistem saat memuat data.</p>';
        });
    });
  });

  btnCloseDetail.addEventListener('click', () => {
    detailDialog.close();
  });
</script>
</body>
</html>
