<!doctype html>
<html lang="id">

<head>
  <script>
    (() => {
      try {
        localStorage.removeItem("themeVariant");
      } catch (_) {}
      try {
        const stored = localStorage.getItem("themeMode");
        if (
          stored
            ? stored === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches
        ) {
          document.documentElement.classList.add("dark");
        }
      } catch (_) { }

      const apply = (dark) => {
        document.documentElement.classList.toggle("dark", dark);
        try {
          localStorage.setItem("themeMode", dark ? "dark" : "light");
        } catch (_) { }
      };

      document.addEventListener("basecoat:theme", (event) => {
        const mode = event.detail?.mode;
        apply(
          mode === "dark"
            ? true
            : mode === "light"
              ? false
              : !document.documentElement.classList.contains("dark"),
        );
      });
    })();
  </script>

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>
    <%= title %>
  </title>

  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="stylesheet" href="/assets/styles.css" />

  <script src="/assets/js/basecoat.js?v=0.3.11" defer></script>
  <script src="/assets/js/command.js?v=0.3.11" defer></script>
  <script src="/assets/js/dropdown-menu.js?v=0.3.11" defer></script>
  <script src="/assets/js/popover.js?v=0.3.11" defer></script>
  <script src="/assets/js/select.js?v=0.3.11" defer></script>
  <script src="/assets/js/sidebar.js?v=0.3.11" defer></script>
  <script src="/assets/js/tabs.js?v=0.3.11" defer></script>
  <script src="/assets/js/toast.js?v=0.3.11" defer></script>

  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <style>
    /* Responsive layout split grid */
    .detail-split-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    @media (min-width: 768px) {
      .detail-split-grid {
        grid-template-columns: 1fr 2fr;
      }
    }
    /* Basecard enhancements */
    .premium-card {
      border: 1px solid var(--border) !important;
      background: var(--card) !important;
      color: var(--card-foreground) !important;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03) !important;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    .premium-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.06) !important;
    }
    /* Select styling */
    select {
      background-color: var(--card) !important;
      color: var(--foreground) !important;
    }
    select option {
      background-color: var(--card) !important;
      color: var(--foreground) !important;
    }
    .dark select option {
      background-color: #1e293b !important;
      color: #f8fafc !important;
    }
    .dark {
      color-scheme: dark;
    }
  </style>
</head>

<body class="bg-background">
  <div class="relative flex min-h-screen">

    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar border-r bg-card text-card-foreground shrink-0" data-side="left"
      aria-hidden="false">
      <nav aria-label="Sidebar navigation" class="flex flex-col h-full justify-between">
        <div>
          <header class="p-4 border-b">
            <a href="/admin/dashboard" class="flex items-center gap-2">
              <img src="/image/fti%20logo.jpg" alt="Logo FTI" class="h-8 w-8 rounded-lg object-contain bg-white p-0.5 border" />
              <div class="grid flex-1 text-left text-sm leading-tight">
                <span class="truncate font-semibold text-foreground">SUKAFTI</span>
                <span class="truncate text-xs text-muted-foreground">Survey Kerjasama</span>
              </div>
            </a>
          </header>

          <section class="p-4">
            <div role="group" aria-labelledby="group-label">
              <h3 id="group-label" class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">
                Menu Utama</h3>
              <ul class="space-y-1">
                <li>
                  <a href="/admin/dashboard"
                    class="flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md hover:bg-accent hover:text-accent-foreground text-muted-foreground">
                    <i data-lucide="layout-dashboard" class="size-4"></i>
                    <span>Dashboard Overview</span>
                  </a>
                </li>
                <li>
                  <a href="/admin/questions"
                    class="flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md hover:bg-accent hover:text-accent-foreground text-muted-foreground">
                    <i data-lucide="help-circle" class="size-4"></i>
                    <span>Pertanyaan Survey</span>
                  </a>
                </li>
                <li>
                  <a href="/admin/partners"
                    class="flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md bg-accent text-accent-foreground">
                    <i data-lucide="building-2" class="size-4 text-foreground"></i>
                    <span>Manajemen Mitra</span>
                  </a>
                </li>
                <li>
                  <a href="/admin/recap-answers"
                    class="flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md hover:bg-accent hover:text-accent-foreground text-muted-foreground">
                    <i data-lucide="bar-chart-3" class="size-4"></i>
                    <span>Hasil Survey</span>
                  </a>
                </li>
              </ul>
            </div>
          </section>
        </div>

        <footer class="p-4 border-t">
          <div id="popover-profile" class="popover w-full">
            <button id="popover-profile-trigger" type="button" aria-expanded="false"
              aria-controls="popover-profile-popover"
              class="flex w-full items-center gap-2 px-3 py-2 rounded-md hover:bg-accent hover:text-accent-foreground justify-start text-left">
              <div
                class="flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 text-primary font-bold text-xs shrink-0">
                AF</div>
              <div class="grid flex-1 text-xs leading-tight">
                <span class="truncate font-semibold text-foreground">
                  <%= user %>
                </span>
                <span class="truncate text-muted-foreground text-[10px]">Administrator</span>
              </div>
              <i data-lucide="chevrons-up-down" class="size-4 text-muted-foreground shrink-0 ml-auto"></i>
            </button>
            <div id="popover-profile-popover" data-popover aria-hidden="true" data-side="top" class="w-[200px]">
              <div class="grid p-1 bg-popover text-popover-foreground border rounded-md shadow-md">
                <a href="/logout"
                  class="flex items-center gap-2 px-2 py-1.5 text-sm text-destructive hover:bg-destructive/10 rounded-sm">
                  <i data-lucide="log-out" class="size-4"></i>
                  <span>Keluar</span>
                </a>
              </div>
            </div>
          </div>
        </footer>
      </nav>
    </aside>

    <!-- Main Content Area -->
    <main id="content" class="flex-1 flex flex-col min-w-0 bg-muted/20">

      <!-- Topbar Header -->
      <header
        class="bg-background sticky inset-x-0 top-0 isolate flex shrink-0 items-center justify-between border-b z-10 h-14 px-4 gap-4">
        <div class="flex items-center gap-2">
          <a href="/admin/partners"
            class="h-8 w-8 inline-flex items-center justify-center rounded-md border hover:bg-accent hover:text-accent-foreground text-muted-foreground mr-1"
            title="Kembali ke Daftar Mitra">
            <i data-lucide="chevron-left" class="size-4"></i>
          </a>
          <h1 class="text-sm font-semibold tracking-tight text-foreground">
            Detail Profil Kemitraan
          </h1>
        </div>

        <div class="flex items-center gap-2">

          <button type="button" aria-label="Toggle dark mode"
            onclick="document.dispatchEvent(new CustomEvent('basecoat:theme'))"
            class="h-8 w-8 inline-flex items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
            <i data-lucide="sun" class="size-4 hidden dark:block"></i>
            <i data-lucide="moon" class="size-4 block dark:hidden"></i>
          </button>
        </div>
      </header>

      <!-- Inner Content -->
      <div class="p-6 md:p-8 flex-1 space-y-6">

        <!-- Alerts -->
        <% if (error) { %>
          <div
            class="bg-destructive/15 text-destructive text-sm p-4 rounded-md border border-destructive/20 flex items-center gap-2">
            <i data-lucide="alert-circle" class="size-4 shrink-0"></i>
            <span>
              <%= error %>
            </span>
          </div>
          <% } %>
            <% if (success) { %>
              <div
                class="bg-emerald-500/10 text-emerald-500 text-sm p-4 rounded-md border border-emerald-500/20 flex items-center gap-2">
                <i data-lucide="check-circle-2" class="size-4 shrink-0"></i>
                <span>
                  <%= success %>
                </span>
              </div>
              <% } %>

                <div class="detail-split-grid items-start">

                  <!-- Left Panel: Profile Info Card -->
                  <div data-slot="card"
                    class="premium-card rounded-2xl p-6 flex flex-col items-center text-center">
                    <% const avatarStr=partner.name.substring(0, 2).toUpperCase(); %>
                      <div
                        class="flex h-20 w-20 items-center justify-center rounded-2xl bg-primary/10 text-primary text-3xl font-extrabold border mb-4">
                        <%= avatarStr %>
                      </div>
                      <h2 class="text-xl font-bold text-foreground leading-tight">
                        <%= partner.name %>
                      </h2>

                      <% let typeBadgeClass='bg-slate-500/10 text-slate-500 border-slate-500/20' ; let
                        typeText='Lainnya' ; if (partner.type==='university' ) {
                        typeBadgeClass='bg-blue-500/10 text-blue-500 border-blue-500/20' ; typeText='Perguruan Tinggi' ;
                        } else if (partner.type==='company' ) {
                        typeBadgeClass='bg-sky-500/10 text-sky-500 border-sky-500/20' ; typeText='Swasta / Bisnis' ; }
                        else if (partner.type==='government' ) {
                        typeBadgeClass='bg-amber-500/10 text-amber-500 border-amber-500/20' ;
                        typeText='Pemerintah / BUMN' ; } else if (partner.type==='ngo' ) {
                        typeBadgeClass='bg-emerald-500/10 text-emerald-500 border-emerald-500/20' ; typeText='NGO / LSM'
                        ; } %>
                        <div class="mt-3 flex flex-col gap-1.5 items-center">
                          <span
                            class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold <%= typeBadgeClass %>">
                            <%= typeText %>
                          </span>
                          <span
                            class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold <%= partner.status === 'active' ? 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20' : 'bg-red-500/10 text-red-500 border-red-500/20' %>">
                            <%= partner.status==='active' ? 'Akun Aktif' : 'Ditangguhkan' %>
                          </span>
                        </div>

                        <!-- Metadata List -->
                        <div class="w-full border-t text-left mt-6 pt-4 space-y-4">
                          <div>
                            <div class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Email
                              Instansi Resmi</div>
                            <div class="text-sm text-foreground mt-0.5">
                              <%= partner.email || '—' %>
                            </div>
                          </div>

                          <div>
                            <div class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Nomor
                              Telepon</div>
                            <div class="text-sm text-foreground mt-0.5">
                              <%= partner.phone || '—' %>
                            </div>
                          </div>

                          <div>
                            <div class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Alamat
                              Kantor</div>
                            <div class="text-sm text-foreground mt-0.5 whitespace-pre-line">
                              <%= partner.address || '—' %>
                            </div>
                          </div>

                          <div>
                            <div class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Fokus
                              Deskripsi Kerjasama</div>
                            <div class="text-sm text-foreground mt-0.5 italic">
                              <%= partner.description || 'Tidak ada catatan deskripsi.' %>
                            </div>
                          </div>
                        </div>

                        <button id="btn-edit-profile"
                          class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2 w-full mt-6">
                          <i data-lucide="edit-3" class="size-4"></i>
                          <span>Ubah Profil</span>
                        </button>
                  </div>

                  <!-- Right Panel: Contacts & Logs (colspan=2) -->
                  <div class="md:col-span-2 space-y-6">

                    <!-- Narahubung Card -->
                    <div data-slot="card" class="premium-card rounded-2xl">
                      <div class="p-6 flex justify-between items-center border-b pb-4">
                        <h3 class="font-semibold leading-none tracking-tight flex items-center gap-2 text-foreground">
                          <i data-lucide="contact" class="size-4 text-primary"></i>
                          <span>Kontak Hubung &amp; Perwakilan</span>
                        </h3>
                        <button id="btn-add-contact"
                          class="inline-flex items-center justify-center gap-1.5 rounded-md text-xs font-semibold transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-8 px-3 py-1">
                          <i data-lucide="plus-circle" class="size-3.5"></i>
                          <span>Tambah Kontak</span>
                        </button>
                      </div>

                      <div class="p-6 divide-y space-y-4">
                        <% if (locals.contacts && contacts.length> 0) { %>
                          <% contacts.forEach(function(c) { %>
                            <div class="flex items-start justify-between pt-4 first:pt-0" id="contact-row-<%= c.id %>">
                              <div class="flex gap-3">
                                <div
                                  class="flex h-9 w-9 items-center justify-center rounded-lg bg-muted text-muted-foreground text-xs">
                                  <i data-lucide="user" class="size-4"></i></div>
                                <div>
                                  <div class="text-sm font-semibold text-foreground flex items-center gap-2">
                                    <span>
                                      <%= c.name %>
                                    </span>
                                    <% if (c.is_primary===1) { %>
                                      <span
                                        class="inline-flex items-center rounded-full border px-1.5 py-0.5 text-[9px] font-bold bg-emerald-500/10 text-emerald-500 border-emerald-500/20 uppercase">Utama</span>
                                      <% } %>
                                  </div>
                                  <div class="text-xs text-muted-foreground mt-0.5">
                                    <%= c.position %>
                                  </div>
                                  <div class="text-xs text-muted-foreground mt-2 flex flex-wrap gap-4">
                                    <span class="flex items-center gap-1"><i data-lucide="mail" class="size-3"></i>
                                      <%= c.email || '—' %>
                                    </span>
                                    <span class="flex items-center gap-1"><i data-lucide="phone" class="size-3"></i>
                                      <%= c.phone || '—' %>
                                    </span>
                                  </div>
                                </div>
                              </div>

                              <% if (c.is_primary !==1) { %>
                                <button
                                  class="h-8 w-8 inline-flex items-center justify-center rounded-md border border-destructive/20 hover:bg-destructive/10 text-destructive"
                                  hx-delete="/admin/partners/contacts/<%= c.id %>"
                                  hx-confirm="Apakah Anda yakin ingin menghapus perwakilan kontak ini dari database?"
                                  hx-target="#contact-row-<%= c.id %>" hx-swap="outerHTML" title="Hapus Kontak">
                                  <i data-lucide="trash-2" class="size-3.5"></i>
                                </button>
                                <% } %>
                            </div>
                            <% }) %>
                              <% } else { %>
                                <div class="text-center text-muted-foreground text-sm py-4">
                                  Belum ada perwakilan kontak terdaftar.
                                </div>
                                <% } %>
                      </div>
                    </div>

                    <!-- Riwayat Survei Card -->
                    <div data-slot="card"
                      class="premium-card rounded-2xl overflow-hidden">
                      <div class="p-6 flex justify-between items-center border-b pb-4">
                        <h3 class="font-semibold leading-none tracking-tight flex items-center gap-2 text-foreground">
                          <i data-lucide="history" class="size-4 text-primary"></i>
                          <span>Riwayat Survei &amp; Aktivitas</span>
                        </h3>

                        <a href="/admin/partners/<%= partner.id %>/export-pdf"
                          class="inline-flex items-center justify-center gap-1.5 rounded-md text-xs font-semibold transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-8 px-3 py-1">
                          <i data-lucide="printer" class="size-3.5"></i>
                          <span>Cetak PDF Laporan</span>
                        </a>
                      </div>

                      <div class="overflow-x-auto w-full">
                        <table class="w-full text-sm">
                          <thead class="bg-muted/50 border-b">
                            <tr class="transition-colors hover:bg-muted/50">
                              <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Judul
                                Survei</th>
                              <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">PIN Akses
                              </th>
                              <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Status PIN
                              </th>
                              <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Selesai
                                Pada</th>
                              <th class="h-10 px-4 text-center align-middle font-medium text-muted-foreground">Skor</th>
                            </tr>
                          </thead>
                          <tbody class="divide-y">
                            <% if (locals.surveys && surveys.length> 0) { %>
                              <% surveys.forEach(function(s) { %>
                                <tr class="hover:bg-muted/30 transition-colors">
                                  <td class="p-4 align-middle font-semibold text-foreground">
                                    <%= s.survey_title %>
                                  </td>
                                  <td class="p-4 align-middle font-mono text-xs">
                                    <%= s.pin %>
                                  </td>
                                  <td class="p-4 align-middle">
                                    <span
                                      class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold <%= s.is_used === 1 ? 'bg-slate-500/10 text-slate-500 border-slate-500/20' : 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20' %>">
                                      <%= s.is_used===1 ? 'Terpakai' : 'Aktif' %>
                                    </span>
                                  </td>
                                  <td class="p-4 align-middle text-muted-foreground text-xs">
                                    <% if (s.used_at) { const d=new Date(s.used_at); %>
                                      <%= d.toLocaleDateString('id-ID', {day:'2-digit', month:'short', year:'numeric'})
                                        %>
                                        <% } else { %>
                                          —
                                          <% } %>
                                  </td>
                                  <td class="p-4 align-middle text-center font-bold text-foreground">
                                    <%= s.is_used===1 ? `${s.score_total} Poin` : '—' %>
                                  </td>
                                </tr>
                                <% }) %>
                                  <% } else { %>
                                    <tr>
                                      <td colspan="5" class="p-6 text-center text-muted-foreground text-xs">
                                        Mitra belum diundang untuk mengikuti survei kerja sama mana pun.
                                      </td>
                                    </tr>
                                    <% } %>
                          </tbody>
                        </table>
                      </div>
                    </div>

                  </div>

                </div>

      </div>
    </main>
  </div>

  <!-- Tambah Narahubung Dialog Modal -->
  <dialog id="contact-dialog"
    class="rounded-xl border bg-card text-card-foreground shadow-lg max-w-md w-full p-6 backdrop:bg-black/50 backdrop:backdrop-blur-sm">
    <div class="flex flex-col gap-4 max-h-[80vh] overflow-y-auto pr-1">
    <div class="flex items-center gap-2 border-b pb-3">
      <div class="p-2 bg-primary/10 text-primary rounded-lg">
        <i data-lucide="contact" class="size-5"></i>
      </div>
      <div>
        <h3 class="text-lg font-semibold leading-none tracking-tight">Tambah Narahubung</h3>
        <p class="text-xs text-muted-foreground mt-1">Tambahkan data perwakilan staf baru dari instansi <%= partner.name
            %>.</p>
      </div>
    </div>

    <form action="/admin/partners/<%= partner.id %>/contacts" method="POST" id="form-add-contact"
      class="flex flex-col gap-4">
      <div class="flex flex-col gap-2">
        <label class="text-sm font-medium leading-none" for="contact-name-input">Nama Lengkap Narahubung</label>
        <input type="text" id="contact-name-input" name="name"
          class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
          placeholder="Nama lengkap beserta gelar..." required />
      </div>

      <div class="flex flex-col gap-2">
        <label class="text-sm font-medium leading-none" for="contact-position-input">Jabatan Narahubung</label>
        <input type="text" id="contact-position-input" name="position"
          class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
          placeholder="Misal: HRD Manager" required />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium leading-none" for="contact-email-input">Email Kontak</label>
          <input type="email" id="contact-email-input" name="email"
            class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
            placeholder="kontak@perusahaan.com" />
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium leading-none" for="contact-phone-input">No HP / WhatsApp</label>
          <input type="text" id="contact-phone-input" name="phone"
            class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
            placeholder="08xxxxxxxxxx" />
        </div>
      </div>

      <div class="flex flex-col gap-2">
        <label class="text-sm font-medium leading-none" for="contact-primary-input">Jadikan Kontak Utama?</label>
        <select id="contact-primary-input" name="is_primary"
          class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring">
          <option value="0" selected>Tidak (Kontak Pendukung)</option>
          <option value="1">Ya (Gantikan Kontak Utama Saat Ini)</option>
        </select>
      </div>

      <div class="flex justify-end gap-2 border-t pt-3 mt-2">
        <button type="button" id="btn-close-contact-modal"
          class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
          Batal
        </button>
        <button type="submit"
          class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2">
          Simpan Kontak
        </button>
      </div>
    </form>
  </div>
</dialog>

  <!-- Ubah Profil Dialog Modal -->
  <dialog id="edit-dialog"
    class="rounded-xl border bg-card text-card-foreground shadow-lg max-w-lg w-full p-6 backdrop:bg-black/50 backdrop:backdrop-blur-sm">
    <div class="flex flex-col gap-4 max-h-[80vh] overflow-y-auto pr-1">
    <div class="flex items-center gap-2 border-b pb-3">
      <div class="p-2 bg-primary/10 text-primary rounded-lg">
        <i data-lucide="edit-3" class="size-5"></i>
      </div>
      <div>
        <h3 class="text-lg font-semibold leading-none tracking-tight">Ubah Profil Kemitraan</h3>
        <p class="text-xs text-muted-foreground mt-1">Perbarui rincian informasi dan legalitas perusahaan mitra
          terdaftar.</p>
      </div>
    </div>

    <form action="/admin/partners/<%= partner.id %>/update" method="POST" id="form-edit-partner"
      class="flex flex-col gap-4">
      <div class="grid grid-cols-2 gap-4">
        <div class="flex flex-col gap-2 col-span-2">
          <label class="text-sm font-medium leading-none" for="edit-name">Nama Instansi / Perusahaan</label>
          <input type="text" id="edit-name" name="name" value="<%= partner.name %>"
            class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
            required />
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium leading-none" for="edit-type">Tipe Kemitraan</label>
          <select id="edit-type" name="type"
            class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
            required>
            <option value="university" <%=partner.type==='university' ? 'selected' : '' %>>Perguruan Tinggi</option>
            <option value="company" <%=partner.type==='company' ? 'selected' : '' %>>Swasta / Perusahaan</option>
            <option value="government" <%=partner.type==='government' ? 'selected' : '' %>>Instansi Pemerintah</option>
            <option value="ngo" <%=partner.type==='ngo' ? 'selected' : '' %>>NGO / LSM</option>
            <option value="other" <%=partner.type==='other' ? 'selected' : '' %>>Lainnya</option>
          </select>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium leading-none" for="edit-status">Status Akun</label>
          <select id="edit-status" name="status"
            class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
            required>
            <option value="active" <%=partner.status==='active' ? 'selected' : '' %>>Aktif</option>
            <option value="inactive" <%=partner.status==='inactive' ? 'selected' : '' %>>Non-Aktif</option>
          </select>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium leading-none" for="edit-email">Email Resmi</label>
          <input type="email" id="edit-email" name="email" value="<%= partner.email || '' %>"
            class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium leading-none" for="edit-phone">Nomor Telepon</label>
          <input type="text" id="edit-phone" name="phone" value="<%= partner.phone || '' %>"
            class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
        </div>

        <div class="flex flex-col gap-2 col-span-2">
          <label class="text-sm font-medium leading-none" for="edit-address">Alamat Lengkap</label>
          <textarea id="edit-address" name="address"
            class="flex min-h-[60px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"><%= partner.address || '' %></textarea>
        </div>

        <div class="flex flex-col gap-2 col-span-2">
          <label class="text-sm font-medium leading-none" for="edit-description">Deskripsi Singkat Kerja Sama</label>
          <textarea id="edit-description" name="description"
            class="flex min-h-[60px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"><%= partner.description || '' %></textarea>
        </div>
      </div>

      <div class="flex justify-end gap-2 border-t pt-3 mt-2">
        <button type="button" id="btn-close-edit-modal"
          class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
          Batal
        </button>
        <button type="submit"
          class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2">
          Simpan Rincian
        </button>
      </div>
    </form>
  </div>
</dialog>

  <script>
    lucide.createIcons();

    const contactModal = document.getElementById('contact-dialog');
    const editProfileModal = document.getElementById('edit-dialog');

    const btnAddContact = document.getElementById('btn-add-contact');
    const btnCloseContactModal = document.getElementById('btn-close-contact-modal');

    const btnEditProfile = document.getElementById('btn-edit-profile');
    const btnCloseEditModal = document.getElementById('btn-close-edit-modal');

    if (btnAddContact) {
      btnAddContact.addEventListener('click', () => {
        contactModal.showModal();
      });
    }
    btnCloseContactModal.addEventListener('click', () => {
      contactModal.close();
    });

    if (btnEditProfile) {
      btnEditProfile.addEventListener('click', () => {
        editProfileModal.showModal();
      });
    }
    btnCloseEditModal.addEventListener('click', () => {
      editProfileModal.close();
    });

    document.body.addEventListener('showAlert', function (evt) {
      alert(evt.detail.value);
    });

    document.body.addEventListener('htmx:afterOnLoad', function (evt) {
      if (evt.detail.requestConfig.method === 'DELETE' && evt.detail.requestConfig.path.includes('/admin/partners/contacts/')) {
        alert('Kontak perwakilan berhasil dihapus secara permanen!');
      }
    });
  </script>
</body>

</html>