<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <!-- Basecoat UI -->
  <link rel="stylesheet" href="https://unpkg.com/basecoat-css@latest/dist/basecoat.min.css" />
  <!-- Dashboard CSS -->
  <link rel="stylesheet" href="/assets/dashboard.css" />
</head>
<body>

<div class="app-shell">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar__brand">
      <img src="/image/fti logo.jpg" alt="Logo FTI" class="sidebar__logo" onerror="this.style.display='none'" />
      <div>
        <div class="sidebar__wordmark">SUKAFTI</div>
        <div class="sidebar__tagline">Survey Kerjasama FTI</div>
      </div>
    </div>

    <div class="nav-section-label">Menu Utama</div>
    <ul class="nav-list">
      <li class="nav-item">
        <a href="/admin/dashboard" id="nav-dashboard">
          <i data-lucide="layout-dashboard"></i>Dashboard
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/questions" class="active" id="nav-questions">
          <i data-lucide="help-circle"></i>Pertanyaan Survey
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/partners" id="nav-mitra">
          <i data-lucide="building-2"></i>Manajemen Mitra
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/recap-answers" id="nav-hasil">
          <i data-lucide="bar-chart-3"></i>Hasil Survey
        </a>
      </li>
    </ul>

    <div class="sidebar__footer">
      <a href="/logout" id="btn-logout"><i data-lucide="log-out"></i>Keluar</a>
    </div>
  </aside>

  <!-- MAIN WRAPPER -->
  <div class="main-wrapper">

    <!-- TOPBAR -->
    <header class="topbar">
      <div class="topbar__left">
        <h2>Pertanyaan Survey</h2>
        <p>Kelola daftar instrumen evaluasi kerja sama FTI</p>
      </div>
      <div class="topbar__right">
        <div class="admin-chip" id="admin-chip">
          <div class="admin-avatar">AF</div>
          <span class="admin-chip__name"><%= user %></span>
        </div>
      </div>
    </header>

    <!-- CONTENT AREA -->
    <main class="content-area">

      <!-- Alerts -->
      <% if (success) { %>
        <div style="background-color: #d1fae5; color: #065f46; padding: 1rem; border-radius: 8px; border: 1px solid #6ee7b7; font-size: 0.875rem; display: flex; align-items: center; gap: 0.5rem; width: 100%;">
          <i data-lucide="check-circle-2" style="width: 1.25rem; height: 1.25rem; flex-shrink: 0;"></i>
          <span><%= success %></span>
        </div>
      <% } %>
      <% if (error) { %>
        <div style="background-color: #fee2e2; color: #991b1b; padding: 1rem; border-radius: 8px; border: 1px solid #fca5a5; font-size: 0.875rem; display: flex; align-items: center; gap: 0.5rem; width: 100%;">
          <i data-lucide="alert-circle" style="width: 1.25rem; height: 1.25rem; flex-shrink: 0;"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <!-- TABLE CARD -->
      <div class="table-card">
        <div class="table-card__header">
          <div>
            <h2>Daftar Pertanyaan Kuesioner</h2>
            <% const selectedSurvey = surveys.find(s => s.id === selectedSurveyId); %>
            <p style="color:#64748b; font-size:0.75rem;"><%= selectedSurvey ? `${selectedSurvey.title} (${selectedSurvey.status})` : 'Tidak ada kuesioner aktif' %></p>
          </div>
          <div style="display:flex; gap:10px;">
            <% if (selectedSurveyId) { %>
              <a href="/admin/questions/export-pdf?survey_id=<%= selectedSurveyId %>" class="btn" style="border: 1px solid #cbd5e1; display:flex; align-items:center; gap:0.5rem; text-decoration:none; color:#334155; padding:0.5rem 1rem; font-size:0.875rem; border-radius:6px; background:#ffffff;">
                <i data-lucide="printer" style="width:16px; height:16px;"></i> Cetak PDF
              </a>
              <button class="btn-generate" id="btn-add-question" type="button" style="background:#0f172a; color:#ffffff; border-radius:6px; border:none; padding:0.5rem 1rem; font-size:0.875rem; display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
                <i data-lucide="plus-circle" style="width:16px; height:16px;"></i> Tambah Pertanyaan
              </button>
            <% } %>
          </div>
        </div>

        <div style="overflow-x:auto;">
          <table class="data-table">
            <thead>
              <tr>
                <th style="text-align:center; width: 80px;">Urutan</th>
                <th>Teks Pertanyaan</th>
                <th style="width: 150px;">Tipe</th>
                <th>Opsi Jawaban &amp; Bobot Skor</th>
                <th style="text-align:center; width: 110px;">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% if (locals.questions && questions.length > 0) { %>
                <% questions.forEach(function(q) { %>
                  <tr id="row-question-<%= q.id %>">
                    <td style="text-align:center; font-weight:700; color:#1e293b;"><%= q.order_number %></td>
                    <td style="font-weight:500; color:#1e293b; max-width: 20rem; line-height: 1.5;"><%= q.question_text %></td>
                    <td>
                      <% if (q.type === 'essay' || q.type === 'short_answer') { %>
                        <span class="pill" style="background:#f1f5f9; color:#475569;">Jawaban Singkat</span>
                      <% } else if (q.type === 'multiple_choice') { %>
                        <span class="pill" style="background:#e0f2fe; color:#0369a1;">Pilihan Ganda</span>
                      <% } else if (q.type === 'single_choice') { %>
                        <span class="pill" style="background:#d1fae5; color:#065f46;">Pilihan Tunggal</span>
                      <% } else if (q.type === 'rating') { %>
                        <span class="pill" style="background:#e0e7ff; color:#4338ca;">Rating Skala</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (q.options && q.options.length > 0) { %>
                        <div style="display:flex; flex-wrap:wrap; gap:6px;">
                          <% q.options.forEach(function(opt) { %>
                            <span class="pill" style="font-size:0.7rem; font-weight:500; background:#f1f5f9; color:#334155; padding:0.2rem 0.5rem; display:inline-flex; align-items:center; gap:4px;">
                              <span><%= opt.option_text %></span>
                              <span style="color:#94a3b8;">•</span>
                              <span style="font-weight:700; color:#64748b;"><%= opt.score %> pts</span>
                            </span>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <span style="font-size:0.75rem; color:#94a3b8; font-style:italic;">— Jawaban bebas deskriptif (Essay) —</span>
                      <% } %>
                    </td>
                    <td>
                      <div class="action-group" style="justify-content:center;">
                        <button class="action-btn btn-edit-question" data-id="<%= q.id %>" data-text="<%= q.question_text %>" data-type="<%= q.type %>" data-order="<%= q.order_number %>" data-options='<%= JSON.stringify(q.options || []) %>' title="Ubah Pertanyaan"><i data-lucide="pencil"></i></button>
                        <button class="action-btn action-btn--del" hx-delete="/admin/questions/<%= q.id %>?survey_id=<%= selectedSurveyId %>" hx-confirm="Apakah Anda yakin ingin menghapus pertanyaan ini?" hx-target="#row-question-<%= q.id %>" hx-swap="outerHTML" title="Hapus Pertanyaan"><i data-lucide="trash-2"></i></button>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" style="text-align:center; color:#94a3b8; padding:3rem;">Belum ada data pertanyaan untuk survey ini. Klik tombol di kanan atas untuk membuat.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div><!-- /.table-card -->

    </main><!-- /.content-area -->
  </div><!-- /.main-wrapper -->
</div><!-- /.app-shell -->

<!-- Add / Edit Dialog Styles -->
<style>
  dialog::backdrop {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
  }
  dialog {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    padding: 2rem;
    border: none;
    border-radius: 12px;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
    max-width: 480px;
    width: 90%;
    background: #ffffff;
    max-height: 85vh;
    overflow-y: auto;
  }
  .form-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 0.75rem;
  }
  .form-row label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #334155;
  }
  .form-row input, .form-row select, .form-row textarea {
    padding: 0.5rem 0.75rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.875rem;
    outline: none;
    background: #f8fafc;
    color: #0f172a;
    width: 100%;
  }
  .form-row input:focus, .form-row select:focus, .form-row textarea:focus {
    border-color: #1e293b;
    background: #ffffff;
  }
</style>

<!-- Add Dialog -->
<dialog id="add-dialog">
  <div class="dialog-header">
    <i data-lucide="help-circle"></i>
    <h3 style="margin:0; font-size: 1.25rem; color: #0f172a;">Tambah Pertanyaan Baru</h3>
  </div>
  <p style="color:#64748b; margin-bottom:1rem; font-size:0.8125rem; line-height:1.4;">Masukkan teks pertanyaan dan tentukan metode pengisian jawaban.</p>
  <form action="/admin/questions" method="POST" id="form-add-question">
    <input type="hidden" name="survey_id" value="<%= selectedSurveyId %>" />
    
    <div class="form-row">
      <label for="add-question-text">Teks Pertanyaan</label>
      <textarea id="add-question-text" name="question_text" rows="3" placeholder="Tuliskan pertanyaan survei..." required></textarea>
    </div>

    <div class="form-row">
      <label for="add-type">Tipe Jawaban</label>
      <select id="add-type" name="type" required>
        <option value="essay">Essay (Teks Deskriptif)</option>
        <option value="multiple_choice">Pilihan Ganda</option>
        <option value="rating">Rating Skala (1-5)</option>
      </select>
    </div>

    <div id="add-options-section" style="border: 1px solid #e2e8f0; border-radius: 6px; padding: 1rem; background: #f8fafc; margin-top: 1rem; display:none;">
      <label style="display:block; font-size:0.8125rem; font-weight:700; color:#64748b; margin-bottom:0.75rem; text-transform:uppercase;">Daftar Pilihan &amp; Bobot Skor</label>
      <div id="add-options-list" style="display:flex; flex-direction:column; gap:8px;"></div>
      <button type="button" id="btn-add-option-row" class="btn" style="border:1px dashed #cbd5e1; border-radius:6px; padding:0.4rem; background:transparent; font-size:0.75rem; width:100%; display:flex; align-items:center; justify-content:center; gap:4px; margin-top:0.75rem; cursor:pointer;">
        <i data-lucide="plus" style="width:12px; height:12px;"></i> Tambah Opsi Jawaban
      </button>
    </div>

    <div style="display:flex; justify-content:flex-end; gap:0.75rem; border-top: 1px solid #e2e8f0; padding-top: 1rem; margin-top: 1rem;">
      <button type="button" id="btn-close-add" class="btn" style="border:1px solid #cbd5e1; padding:0.5rem 1rem; border-radius:6px; background:transparent; cursor:pointer;">Batal</button>
      <button type="submit" class="btn" style="background:#0f172a; color:white; border:none; border-radius:6px; padding:0.5rem 1rem; cursor:pointer;">Simpan Pertanyaan</button>
    </div>
  </form>
</dialog>

<!-- Edit Dialog -->
<dialog id="edit-dialog">
  <div class="dialog-header">
    <i data-lucide="pencil"></i>
    <h3 style="margin:0; font-size: 1.25rem; color: #0f172a;">Ubah Pertanyaan</h3>
  </div>
  <p style="color:#64748b; margin-bottom:1rem; font-size:0.8125rem; line-height:1.4;">Perbarui teks pertanyaan, tipe, maupun urutan butir instrumen.</p>
  <form id="form-edit-question" method="POST">
    <input type="hidden" name="survey_id" value="<%= selectedSurveyId %>" />
    
    <div class="form-row">
      <label for="edit-question-text">Teks Pertanyaan</label>
      <textarea id="edit-question-text" name="question_text" rows="3" required></textarea>
    </div>

    <div class="form-row">
      <label for="edit-type">Tipe Jawaban</label>
      <select id="edit-type" name="type" required>
        <option value="essay">Essay (Teks Deskriptif)</option>
        <option value="multiple_choice">Pilihan Ganda</option>
        <option value="rating">Rating Skala (1-5)</option>
      </select>
    </div>

    <div id="edit-options-section" style="border: 1px solid #e2e8f0; border-radius: 6px; padding: 1rem; background: #f8fafc; margin-top: 1rem; display:none;">
      <label style="display:block; font-size:0.8125rem; font-weight:700; color:#64748b; margin-bottom:0.75rem; text-transform:uppercase;">Daftar Pilihan &amp; Bobot Skor</label>
      <div id="edit-options-list" style="display:flex; flex-direction:column; gap:8px;"></div>
      <button type="button" id="btn-edit-add-option-row" class="btn" style="border:1px dashed #cbd5e1; border-radius:6px; padding:0.4rem; background:transparent; font-size:0.75rem; width:100%; display:flex; align-items:center; justify-content:center; gap:4px; margin-top:0.75rem; cursor:pointer;">
        <i data-lucide="plus" style="width:12px; height:12px;"></i> Tambah Opsi Jawaban
      </button>
    </div>

    <div style="display:flex; justify-content:flex-end; gap:0.75rem; border-top: 1px solid #e2e8f0; padding-top: 1rem; margin-top: 1rem;">
      <button type="button" id="btn-close-edit" class="btn" style="border:1px solid #cbd5e1; padding:0.5rem 1rem; border-radius:6px; background:transparent; cursor:pointer;">Batal</button>
      <button type="submit" class="btn" style="background:#0f172a; color:white; border:none; border-radius:6px; padding:0.5rem 1rem; cursor:pointer;">Simpan Perubahan</button>
    </div>
  </form>
</dialog>

<script>
  lucide.createIcons();

  const addDialog = document.getElementById('add-dialog');
  const editDialog = document.getElementById('edit-dialog');

  const btnAddQuestion = document.getElementById('btn-add-question');
  const btnCloseAdd = document.getElementById('btn-close-add');
  const btnCloseEdit = document.getElementById('btn-close-edit');

  const addTypeSelect = document.getElementById('add-type');
  const addOptionsSection = document.getElementById('add-options-section');
  const addOptionsList = document.getElementById('add-options-list');
  const btnAddOptionRow = document.getElementById('btn-add-option-row');

  const editTypeSelect = document.getElementById('edit-type');
  const editOptionsSection = document.getElementById('edit-options-section');
  const editOptionsList = document.getElementById('edit-options-list');
  const btnEditAddOptionRow = document.getElementById('btn-edit-add-option-row');
  const formEditQuestion = document.getElementById('form-edit-question');

  function createOptionRowHTML(container, text = '', score = 0) {
    const row = document.createElement('div');
    row.style.cssText = 'display:flex; gap:8px; align-items:center;';

    const textInput = document.createElement('input');
    textInput.type = 'text';
    textInput.name = 'option_text';
    textInput.style.cssText = 'flex:3; padding:0.4rem; border:1px solid #cbd5e1; border-radius:6px; font-size:0.8rem; outline:none; background:#ffffff;';
    textInput.placeholder = 'Misal: Puas';
    textInput.value = text;
    textInput.required = true;

    const scoreInput = document.createElement('input');
    scoreInput.type = 'number';
    scoreInput.name = 'option_score';
    scoreInput.style.cssText = 'flex:1; padding:0.4rem; border:1px solid #cbd5e1; border-radius:6px; font-size:0.8rem; outline:none; background:#ffffff; text-align:center;';
    scoreInput.placeholder = 'Skor';
    scoreInput.value = score;
    scoreInput.min = '0';
    scoreInput.required = true;

    const deleteBtn = document.createElement('button');
    deleteBtn.type = 'button';
    deleteBtn.className = 'action-btn action-btn--del';
    deleteBtn.style.cssText = 'flex-shrink:0;';
    deleteBtn.innerHTML = '<i data-lucide="trash-2"></i>';
    deleteBtn.addEventListener('click', () => {
      row.remove();
    });

    row.appendChild(textInput);
    row.appendChild(scoreInput);
    row.appendChild(deleteBtn);
    container.appendChild(row);
    lucide.createIcons();
  }

  function toggleOptionsContainer(typeSelect, sectionElement, listElement) {
    const val = typeSelect.value;
    if (val === 'multiple_choice' || val === 'rating') {
      sectionElement.style.display = 'block';
      if (listElement.children.length === 0) {
        if (val === 'rating') {
          createOptionRowHTML(listElement, 'Sangat Tidak Puas', 1);
          createOptionRowHTML(listElement, 'Tidak Puas', 2);
          createOptionRowHTML(listElement, 'Cukup', 3);
          createOptionRowHTML(listElement, 'Puas', 4);
          createOptionRowHTML(listElement, 'Sangat Puas', 5);
        } else {
          createOptionRowHTML(listElement, 'Opsi 1', 1);
          createOptionRowHTML(listElement, 'Opsi 2', 2);
        }
      }
    } else {
      sectionElement.style.display = 'none';
    }
  }

  if (btnAddQuestion) {
    btnAddQuestion.addEventListener('click', () => {
      addDialog.showModal();
      document.getElementById('add-question-text').value = '';
      addTypeSelect.value = 'essay';
      addOptionsList.innerHTML = '';
      addOptionsSection.style.display = 'none';
    });
  }

  btnCloseAdd.addEventListener('click', () => {
    addDialog.close();
  });

  addTypeSelect.addEventListener('change', () => {
    toggleOptionsContainer(addTypeSelect, addOptionsSection, addOptionsList);
  });

  btnAddOptionRow.addEventListener('click', () => {
    createOptionRowHTML(addOptionsList, '', 0);
  });

  document.querySelectorAll('.btn-edit-question').forEach(btn => {
    btn.addEventListener('click', function () {
      const id = this.getAttribute('data-id');
      const text = this.getAttribute('data-text');
      const type = this.getAttribute('data-type');
      const options = JSON.parse(this.getAttribute('data-options') || '[]');

      formEditQuestion.action = `/admin/questions/${id}/update`;

      document.getElementById('edit-question-text').value = text;
      editTypeSelect.value = type;

      editOptionsList.innerHTML = '';
      if (type === 'multiple_choice' || type === 'rating') {
        editOptionsSection.style.display = 'block';
        options.forEach(opt => {
          createOptionRowHTML(editOptionsList, opt.option_text, opt.score);
        });
      } else {
        editOptionsSection.style.display = 'none';
      }

      editDialog.showModal();
    });
  });

  btnCloseEdit.addEventListener('click', () => {
    editDialog.close();
  });

  editTypeSelect.addEventListener('change', () => {
    toggleOptionsContainer(editTypeSelect, editOptionsSection, editOptionsList);
  });

  btnEditAddOptionRow.addEventListener('click', () => {
    createOptionRowHTML(editOptionsList, '', 0);
  });

  document.body.addEventListener('htmx:afterOnLoad', function (evt) {
    if (evt.detail.requestConfig.method === 'DELETE' && evt.detail.requestConfig.path.includes('/admin/questions/')) {
      const rows = document.querySelectorAll('.data-table tbody tr');
      let index = 1;
      rows.forEach(row => {
        const orderCell = row.querySelector('td:first-child');
        if (orderCell && row.id.startsWith('row-question-')) {
          orderCell.textContent = index++;
        }
      });
    }
  });
</script>
</body>
</html>
