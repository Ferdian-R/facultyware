<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Manajemen Pertanyaan Survey SUKAFTI — FTI Universitas Andalas." />
  <title><%= title %></title>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <!-- Basecoat UI -->
  <link rel="stylesheet" href="https://unpkg.com/basecoat-css@latest/dist/basecoat.min.css" />
  <!-- Dashboard CSS -->
  <link rel="stylesheet" href="/css/dashboard.css" />
  <!-- HTMX -->
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  
  <style>
    /* Custom modifications for dialog */
    dialog::backdrop {
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(4px);
    }
    dialog {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      margin: 0;
      padding: 2.5rem;
      border: none;
      border-radius: 12px;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
      width: 500px;
      max-width: 90%;
      background: #ffffff;
      max-height: 90vh;
      overflow-y: auto;
    }
    .dialog-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }
    .dialog-header i {
      color: var(--dk-primary);
    }
    .form-group {
      margin-bottom: 1.25rem;
    }
    .form-group label {
      display: block;
      font-size: 0.875rem;
      font-weight: 600;
      color: #334155;
      margin-bottom: 0.5rem;
    }
    .form-control {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      background: #f8fafc;
      color: #0f172a;
      outline: none;
      font-family: inherit;
      font-size: 0.875rem;
      transition: all 0.2s;
    }
    .form-control:focus {
      border-color: var(--dk-primary);
      background: #fff;
    }
    
    /* Dynamic option styles */
    .options-section {
      border: 1px dashed var(--dk-s300);
      border-radius: 8px;
      padding: 1rem;
      background: #fafafa;
      margin-top: 1rem;
    }
    .option-row {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-bottom: 8px;
    }
    .option-row input[type="text"] {
      flex: 3;
    }
    .option-row input[type="number"] {
      flex: 1;
      text-align: center;
    }
    .btn-add-option {
      background: transparent;
      border: 1px dashed var(--dk-s400);
      color: var(--dk-s700);
      padding: 0.5rem;
      border-radius: 6px;
      width: 100%;
      cursor: pointer;
      font-size: 0.825rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      transition: all 0.2s;
    }
    .btn-add-option:hover {
      background: var(--dk-s100);
    }
    .btn-remove-option {
      background: #fee2e2;
      border: none;
      color: #ef4444;
      width: 32px;
      height: 32px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
    }
    .btn-remove-option:hover {
      background: #fca5a5;
    }
    
    .badge-type {
      display: inline-block;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
    }
    .badge-type--rating { background: #dbeafe; color: #1e40af; }
    .badge-type--mc { background: #e0f2fe; color: #0369a1; }
    .badge-type--essay { background: #f1f5f9; color: #475569; }
    
    .alert-banner {
      padding: 0.75rem 1.25rem;
      border-radius: 8px;
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
    }
    .alert-banner--success { background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }
    .alert-banner--error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

    /* Custom badge weights */
    .option-tag {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: var(--dk-s100);
      border: 1px solid var(--dk-s200);
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      font-size: 0.75rem;
      margin: 2px;
      color: var(--dk-s700);
    }
    .option-tag span {
      background: var(--dk-s700);
      color: white;
      font-size: 0.65rem;
      padding: 1px 4px;
      border-radius: 3px;
      font-weight: bold;
    }
  </style>
</head>
<body>

<div class="app-shell">

  <!-- ══════════════════════════════════
       SIDEBAR
       ══════════════════════════════════ -->
  <aside class="sidebar">
    <div class="sidebar__brand">
      <div class="admin-avatar" style="width:38px; height:38px; border-radius:10px; font-size:1.1rem;">FTI</div>
      <div>
        <div class="sidebar__wordmark">SUKAFTI</div>
        <div class="sidebar__tagline">Survey Kerjasama FTI</div>
      </div>
    </div>

    <div class="nav-section-label">Menu Utama</div>
    <ul class="nav-list">
      <li class="nav-item"><a href="/admin/dashboard" id="nav-dashboard"><i data-lucide="layout-dashboard"></i>Dashboard</a></li>
      <li class="nav-item"><a href="/admin/questions" class="active" id="nav-questions"><i data-lucide="help-circle"></i>Pertanyaan Survey</a></li>
      <li class="nav-item"><a href="#" id="nav-mitra" style="opacity: 0.6; cursor: not-allowed;"><i data-lucide="building-2"></i>Manajemen Mitra</a></li>
      <li class="nav-item"><a href="#" id="nav-pin" style="opacity: 0.6; cursor: not-allowed;"><i data-lucide="key-round"></i>Kelola PIN Survey</a></li>
      <li class="nav-item"><a href="#" id="nav-hasil" style="opacity: 0.6; cursor: not-allowed;"><i data-lucide="bar-chart-3"></i>Hasil Survey</a></li>
    </ul>

    <div class="nav-section-label" style="margin-top:.75rem;">Pengaturan</div>
    <ul class="nav-list">
      <li class="nav-item"><a href="#" id="nav-profile" style="opacity: 0.6; cursor: not-allowed;"><i data-lucide="user-cog"></i>Profil Admin</a></li>
    </ul>

    <div class="sidebar__footer">
      <a href="/logout" id="btn-logout"><i data-lucide="log-out"></i>Keluar</a>
    </div>
  </aside>

  <!-- ══════════════════════════════════
       MAIN WRAPPER
       ══════════════════════════════════ -->
  <div class="main-wrapper">

    <!-- TOPBAR -->
    <header class="topbar">
      <div class="topbar__left">
        <h2>Instrumen Pertanyaan Survei</h2>
        <p id="topbar-date">Kelola butir kuesioner penilaian mitra industri</p>
      </div>
      <div class="topbar__right">
        <div class="admin-chip" id="admin-chip">
          <div class="admin-avatar">AF</div>
          <span class="admin-chip__name"><%= user %></span>
        </div>
      </div>
    </header>

    <!-- CONTENT AREA -->
    <main class="content-area" id="main-content">

      <!-- Alerts -->
      <% if (success) { %>
        <div class="alert-banner alert-banner--success"><%= success %></div>
      <% } %>
      <% if (error) { %>
        <div class="alert-banner alert-banner--error"><%= error %></div>
      <% } %>

      <!-- ① FILTER & ACTION BAR -->
      <div class="table-card" style="padding: 1.25rem 1.5rem; margin-bottom: 0px;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          
          <form method="GET" action="/admin/questions" style="display: flex; align-items: center; gap: 10px;">
            <label style="font-size: 0.875rem; font-weight: 600; color: #475569;">Pilih Kuesioner:</label>
            <select name="survey_id" onchange="this.form.submit()" class="form-control" style="width: 320px; margin: 0; padding: 0.5rem 0.75rem;">
              <% if(locals.surveys && surveys.length > 0) { %>
                <% surveys.forEach(function(s) { %>
                  <option value="<%= s.id %>" <%= s.id === selectedSurveyId ? 'selected' : '' %>>
                    <%= s.title %> (<%= s.status %>)
                  </option>
                <% }) %>
              <% } else { %>
                <option value="">Belum ada survey</option>
              <% } %>
            </select>
          </form>

          <div style="display:flex; gap:10px;">
            <% if (selectedSurveyId) { %>
              <a href="/admin/questions/export-pdf?survey_id=<%= selectedSurveyId %>" class="btn" style="background-color: #0f172a; color: white; padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600;">
                <i data-lucide="printer"></i> Cetak Laporan PDF
              </a>
              <button class="btn-generate" id="btn-add-question" type="button">
                <i data-lucide="plus-circle"></i> Tambah Pertanyaan
              </button>
            <% } %>
          </div>
        </div>
      </div>

      <!-- ② DATA TABLE -->
      <div class="table-card">
        <div class="table-card__header">
          <div>
            <h2>Daftar Butir Pertanyaan</h2>
            <p>Konfigurasi instrumen evaluasi kerja sama FTI</p>
          </div>
        </div>

        <div style="overflow-x:auto;">
          <table class="data-table">
            <thead>
              <tr>
                <th style="width: 70px; text-align: center;">Urutan</th>
                <th>Teks Pertanyaan</th>
                <th style="width: 150px;">Tipe</th>
                <th>Opsi Jawaban &amp; Bobot Skor</th>
                <th style="width: 110px; text-align: center;">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% if (locals.questions && questions.length > 0) { %>
                <% questions.forEach(function(q) { %>
                  <tr id="row-question-<%= q.id %>">
                    <td style="text-align: center; font-weight: 600;"><%= q.order_number %></td>
                    <td style="font-weight: 500; color: #1e293b; max-width: 300px; line-height: 1.4;"><%= q.question_text %></td>
                    <td>
                      <% if (q.type === 'essay') { %>
                        <span class="badge-type badge-type--essay">Essay</span>
                      <% } else if (q.type === 'multiple_choice') { %>
                        <span class="badge-type badge-type--mc">Pilihan Ganda</span>
                      <% } else if (q.type === 'rating') { %>
                        <span class="badge-type badge-type--rating">Rating Skala</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (q.options && q.options.length > 0) { %>
                        <div style="display: flex; flex-wrap: wrap;">
                          <% q.options.forEach(function(opt) { %>
                            <span class="option-tag">
                              <%= opt.option_text %> <span><%= opt.score %></span>
                            </span>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <span style="color:#94a3b8; font-style: italic;">— Jawaban bebas deskriptif (Essay) —</span>
                      <% } %>
                    </td>
                    <td>
                      <div class="action-group" style="justify-content: center;">
                        <button class="action-btn btn-edit-question" 
                                data-id="<%= q.id %>" 
                                data-text="<%= q.question_text %>" 
                                data-type="<%= q.type %>"
                                data-order="<%= q.order_number %>"
                                data-options='<%= JSON.stringify(q.options || []) %>'
                                title="Ubah Pertanyaan">
                          <i data-lucide="edit-3"></i>
                        </button>
                        <button class="action-btn action-btn--del" 
                                hx-delete="/admin/questions/<%= q.id %>?survey_id=<%= selectedSurveyId %>"
                                hx-confirm="Apakah Anda yakin ingin menghapus pertanyaan ini?"
                                hx-target="#row-question-<%= q.id %>"
                                hx-swap="outerHTML"
                                title="Hapus Pertanyaan">
                          <i data-lucide="trash-2"></i>
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" style="text-align:center; color:#94a3b8; padding:3rem;">
                    Belum ada data pertanyaan untuk survey ini. Klik tombol di kanan atas untuk membuat.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div><!-- /.table-card -->

    </main><!-- /.content-area -->
  </div><!-- /.main-wrapper -->
</div><!-- /.app-shell -->

<!-- ══════════════════════════════════
     MODAL DIALOG: TAMBAH PERTANYAAN
     ══════════════════════════════════ -->
<dialog id="add-dialog">
  <div class="dialog-header">
    <i data-lucide="help-circle"></i>
    <h3 style="margin:0; font-size: 1.25rem; color: #0f172a;">Tambah Pertanyaan Baru</h3>
  </div>
  <p style="color:#64748b; margin-bottom:1.5rem; font-size:0.875rem; line-height:1.5;">Masukkan teks pertanyaan dan tentukan metode pengisian jawaban.</p>
  
  <form action="/admin/questions" method="POST" id="form-add-question">
    <input type="hidden" name="survey_id" value="<%= selectedSurveyId %>" />
    
    <div class="form-group">
      <label for="add-question-text">Teks Pertanyaan</label>
      <textarea id="add-question-text" name="question_text" class="form-control" rows="3" placeholder="Tuliskan pertanyaan survei..." required></textarea>
    </div>

    <div class="form-group">
      <label for="add-type">Tipe Jawaban</label>
      <select id="add-type" name="type" class="form-control" required>
        <option value="essay">Essay (Teks Deskriptif)</option>
        <option value="multiple_choice">Pilihan Ganda</option>
        <option value="rating">Rating Skala (1-5)</option>
      </select>
    </div>

    <!-- Opsi Jawaban Container (Multiple Choice / Rating) -->
    <div id="add-options-section" class="options-section" style="display:none;">
      <label style="display:block; font-size:0.875rem; font-weight:600; color:#334155; margin-bottom:0.5rem;">Daftar Pilihan &amp; Bobot Skor</label>
      <div id="add-options-list">
        <!-- Opsi terisi dinamis via JS -->
      </div>
      <button type="button" class="btn-add-option" id="btn-add-option-row">
        <i data-lucide="plus" style="width:14px; height:14px;"></i> Tambah Opsi Jawaban
      </button>
    </div>

    <div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top: 1.5rem;">
      <button type="button" id="btn-close-add" class="btn btn--ghost-muted" style="border:1px solid #cbd5e1;">Batal</button>
      <button type="submit" class="btn btn--primary" style="background:#0f172a; color:white; border:none; border-radius:6px; padding:0.5rem 1rem;">
        Simpan Pertanyaan
      </button>
    </div>
  </form>
</dialog>

<!-- ══════════════════════════════════
     MODAL DIALOG: EDIT PERTANYAAN
     ══════════════════════════════════ -->
<dialog id="edit-dialog">
  <div class="dialog-header">
    <i data-lucide="edit-3"></i>
    <h3 style="margin:0; font-size: 1.25rem; color: #0f172a;">Ubah Pertanyaan</h3>
  </div>
  <p style="color:#64748b; margin-bottom:1.5rem; font-size:0.875rem; line-height:1.5;">Perbarui teks pertanyaan, tipe, maupun urutan butir instrumen.</p>
  
  <form id="form-edit-question" method="POST">
    <input type="hidden" name="survey_id" value="<%= selectedSurveyId %>" />
    
    <div class="form-group">
      <label for="edit-question-text">Teks Pertanyaan</label>
      <textarea id="edit-question-text" name="question_text" class="form-control" rows="3" placeholder="Tuliskan pertanyaan survei..." required></textarea>
    </div>

    <div class="form-group">
      <label for="edit-type">Tipe Jawaban</label>
      <select id="edit-type" name="type" class="form-control" required>
        <option value="essay">Essay (Teks Deskriptif)</option>
        <option value="multiple_choice">Pilihan Ganda</option>
        <option value="rating">Rating Skala (1-5)</option>
      </select>
    </div>

    <!-- Opsi Jawaban Container (Multiple Choice / Rating) -->
    <div id="edit-options-section" class="options-section" style="display:none;">
      <label style="display:block; font-size:0.875rem; font-weight:600; color:#334155; margin-bottom:0.5rem;">Daftar Pilihan &amp; Bobot Skor</label>
      <div id="edit-options-list">
        <!-- Opsi terisi dinamis via JS -->
      </div>
      <button type="button" class="btn-add-option" id="btn-edit-add-option-row">
        <i data-lucide="plus" style="width:14px; height:14px;"></i> Tambah Opsi Jawaban
      </button>
    </div>

    <div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top: 1.5rem;">
      <button type="button" id="btn-close-edit" class="btn btn--ghost-muted" style="border:1px solid #cbd5e1;">Batal</button>
      <button type="submit" class="btn btn--primary" style="background:#0f172a; color:white; border:none; border-radius:6px; padding:0.5rem 1rem;">
        Simpan Perubahan
      </button>
    </div>
  </form>
</dialog>

<script>
  // ── Lucide Icons ───────────────────────────────────────
  lucide.createIcons();

  // ── Modal & Dynamic Options Logic ──────────────────────
  const addDialog = document.getElementById('add-dialog');
  const editDialog = document.getElementById('edit-dialog');
  
  const btnAddQuestion = document.getElementById('btn-add-question');
  const btnCloseAdd = document.getElementById('btn-close-add');
  const btnCloseEdit = document.getElementById('btn-close-edit');

  const addTypeSelect = document.getElementById('add-type');
  const addOptionsSection = document.getElementById('add-options-section');
  const addOptionsList = document.getElementById('add-options-list');
  const btnAddOptionRow = document.getElementById('btn-add-option-row');

  const editTypeSelect = document.getElementById('edit-type');
  const editOptionsSection = document.getElementById('edit-options-section');
  const editOptionsList = document.getElementById('edit-options-list');
  const btnEditAddOptionRow = document.getElementById('btn-edit-add-option-row');
  const formEditQuestion = document.getElementById('form-edit-question');

  // Helper: Append a new option input row
  function createOptionRowHTML(container, text = '', score = 0) {
    const row = document.createElement('div');
    row.className = 'option-row';
    
    const textInput = document.createElement('input');
    textInput.type = 'text';
    textInput.name = 'option_text';
    textInput.className = 'form-control';
    textInput.placeholder = 'Misal: Sangat Puas / Ya';
    textInput.value = text;
    textInput.required = true;

    const scoreInput = document.createElement('input');
    scoreInput.type = 'number';
    scoreInput.name = 'option_score';
    scoreInput.className = 'form-control';
    scoreInput.placeholder = 'Skor';
    scoreInput.value = score;
    scoreInput.min = '0';
    scoreInput.required = true;

    const deleteBtn = document.createElement('button');
    deleteBtn.type = 'button';
    deleteBtn.className = 'btn-remove-option';
    deleteBtn.innerHTML = '<i data-lucide="trash-2" style="width:14px; height:14px;"></i>';
    deleteBtn.addEventListener('click', () => {
      row.remove();
    });

    row.appendChild(textInput);
    row.appendChild(scoreInput);
    row.appendChild(deleteBtn);
    container.appendChild(row);
    lucide.createIcons();
  }

  // Toggle options visibility based on question type
  function toggleOptionsContainer(typeSelect, sectionElement, listElement) {
    const val = typeSelect.value;
    if (val === 'multiple_choice' || val === 'rating') {
      sectionElement.style.display = 'block';
      if (listElement.children.length === 0) {
        // Pre-fill some defaults if empty
        if (val === 'rating') {
          createOptionRowHTML(listElement, 'Sangat Tidak Puas', 1);
          createOptionRowHTML(listElement, 'Tidak Puas', 2);
          createOptionRowHTML(listElement, 'Cukup', 3);
          createOptionRowHTML(listElement, 'Puas', 4);
          createOptionRowHTML(listElement, 'Sangat Puas', 5);
        } else {
          createOptionRowHTML(listElement, 'Opsi 1', 1);
          createOptionRowHTML(listElement, 'Opsi 2', 2);
        }
      }
    } else {
      sectionElement.style.display = 'none';
    }
  }

  // Add Question listeners
  if(btnAddQuestion) {
    btnAddQuestion.addEventListener('click', () => {
      addDialog.showModal();
      // Reset form text
      document.getElementById('add-question-text').value = '';
      addTypeSelect.value = 'essay';
      addOptionsList.innerHTML = '';
      addOptionsSection.style.display = 'none';
    });
  }

  btnCloseAdd.addEventListener('click', () => {
    addDialog.close();
  });

  addTypeSelect.addEventListener('change', () => {
    toggleOptionsContainer(addTypeSelect, addOptionsSection, addOptionsList);
  });

  btnAddOptionRow.addEventListener('click', () => {
    createOptionRowHTML(addOptionsList, '', 0);
  });

  // Edit Question listeners
  document.querySelectorAll('.btn-edit-question').forEach(btn => {
    btn.addEventListener('click', function() {
      const id = this.getAttribute('data-id');
      const text = this.getAttribute('data-text');
      const type = this.getAttribute('data-type');
      const order = this.getAttribute('data-order');
      const options = JSON.parse(this.getAttribute('data-options') || '[]');

      // Set action route on the form dynamically
      formEditQuestion.action = `/admin/questions/${id}/update`;

      // Fill in details
      document.getElementById('edit-question-text').value = text;
      editTypeSelect.value = type;

      // Populate options list
      editOptionsList.innerHTML = '';
      if (type === 'multiple_choice' || type === 'rating') {
        editOptionsSection.style.display = 'block';
        options.forEach(opt => {
          createOptionRowHTML(editOptionsList, opt.option_text, opt.score);
        });
      } else {
        editOptionsSection.style.display = 'none';
      }

      editDialog.showModal();
    });
  });

  btnCloseEdit.addEventListener('click', () => {
    editDialog.close();
  });

  editTypeSelect.addEventListener('change', () => {
    toggleOptionsContainer(editTypeSelect, editOptionsSection, editOptionsList);
  });

  btnEditAddOptionRow.addEventListener('click', () => {
    createOptionRowHTML(editOptionsList, '', 0);
  });

  // Resequence order numbers in the UI table dynamically when HTMX deletes a row
  document.body.addEventListener('htmx:afterOnLoad', function(evt) {
    if (evt.detail.requestConfig.method === 'DELETE' && evt.detail.requestConfig.path.includes('/admin/questions/')) {
      const rows = document.querySelectorAll('.data-table tbody tr');
      let index = 1;
      rows.forEach(row => {
        const orderCell = row.querySelector('td:first-child');
        if (orderCell && !row.classList.contains('empty-row')) {
          orderCell.textContent = index++;
        }
      });
    }
  });

</script>
</body>
</html>
