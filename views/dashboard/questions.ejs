                                <% } else if (q.type === 'single_choice') { %>
                                  <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold bg-emerald-500/10 text-emerald-500 border-emerald-500/20">Pilihan Tunggal</span>
                                <% } else if (q.type === 'rating') { %>
                                  <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold bg-blue-500/10 text-blue-500 border-blue-500/20">Rating Skala</span>
                                <% } %>
                              </td>
                              <td>
                                <% if (q.options && q.options.length> 0) { %>
                                  <div class="flex flex-wrap gap-1.5">
                                    <% q.options.forEach(function(opt) { %>
                                      <span
                                        class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/40 hover:bg-muted px-2.5 py-1 text-xs text-foreground font-medium transition-colors">
                                        <span>
                                          <%= opt.option_text %>
                                        </span>
                                        <span class="text-muted-foreground/60 font-normal">&bull;</span>
                                        <span class="text-[10px] font-extrabold text-muted-foreground"><%= opt.score %> pts</span>
                                      </span>
                                      <% }) %>
                                  </div>
                                  <% } else { %>
                                    <span class="text-xs text-muted-foreground italic">â€” Jawaban bebas deskriptif (Essay) â€”</span>
                                    <% } %>
                              </td>
                              <td class="text-center">
                                <div class="flex items-center justify-center gap-2">
                                  <button
                                    style="width: 32px; height: 32px; min-width: 32px; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;"
                                    class="btn-edit-question rounded-md border hover:bg-accent hover:text-accent-foreground text-muted-foreground"
                                    data-id="<%= q.id %>" data-text="<%= q.question_text %>" data-type="<%= q.type %>"
                                    data-order="<%= q.order_number %>"
                                    data-options='<%= JSON.stringify(q.options || []) %>' title="Ubah Pertanyaan">
                                    <i data-lucide="edit-3" class="size-3.5"></i>
                                  </button>
                                  <button
                                    style="width: 32px; height: 32px; min-width: 32px; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;"
                                    class="rounded-md border border-destructive/20 hover:bg-destructive/10 text-destructive"
                                    hx-delete="/admin/questions/<%= q.id %>?survey_id=<%= selectedSurveyId %>"
                                    hx-confirm="Apakah Anda yakin ingin menghapus pertanyaan ini?"
                                    hx-target="#row-question-<%= q.id %>" hx-swap="outerHTML" title="Hapus Pertanyaan">
                                    <i data-lucide="trash-2" class="size-3.5"></i>
                                  </button>
                                </div>
                              </td>
                            </tr>
                            <% }); %>
                              <% } else { %>
                                <tr>
                                  <td colspan="5" class="p-8 text-center text-muted-foreground">
                                    Belum ada data pertanyaan untuk survey ini. Klik tombol di kanan atas untuk membuat.
                                  </td>
                                </tr>
                                <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>

      </div>
    </main>
  </div>

