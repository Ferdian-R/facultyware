                          <i data-lucide="plus-circle" class="size-4"></i>
                          <span>Tambah Pertanyaan</span>
                        </button>
                        <% } %>
                    </div>
                  </div>

                  <div class="overflow-x-auto w-full">
                    <table class="questions-table text-sm">
                      <thead>
                        <tr>
                          <th class="text-center w-20">Urutan</th>
                          <th class="text-left">Teks Pertanyaan</th>
                          <th class="text-left w-36">Tipe</th>
                          <th class="text-left">Opsi Jawaban &amp; Bobot Skor</th>
                          <th class="text-center w-28">Aksi</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (locals.questions && questions.length> 0) { %>
                          <% questions.forEach(function(q) { %>
                            <tr id="row-question-<%= q.id %>">
                              <td class="text-center font-bold text-foreground">
                                <%= q.order_number %>
                              </td>
                              <td class="font-medium text-foreground max-w-xs leading-relaxed">
                                <%= q.question_text %>
                              </td>
                              <td>
                                <% if (q.type === 'essay' || q.type === 'short_answer') { %>
                                  <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold bg-slate-500/10 text-slate-500 border-slate-500/20">Jawaban Singkat</span>
                                <% } else if (q.type === 'multiple_choice') { %>
