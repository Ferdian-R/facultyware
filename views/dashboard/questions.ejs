<!doctype html>
<html lang="id">

<head>
  <script>
    (() => {
      try {
        localStorage.removeItem("themeVariant");
      } catch (_) { }
      try {
        const stored = localStorage.getItem("themeMode");
        if (
          stored
            ? stored === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches
        ) {
          document.documentElement.classList.add("dark");
        }
      } catch (_) { }

      const apply = (dark) => {
        document.documentElement.classList.toggle("dark", dark);
        try {
          localStorage.setItem("themeMode", dark ? "dark" : "light");
        } catch (_) { }
      };

      document.addEventListener("basecoat:theme", (event) => {
        const mode = event.detail?.mode;
        apply(
          mode === "dark"
            ? true
            : mode === "light"
              ? false
              : !document.documentElement.classList.contains("dark"),
        );
      });
    })();
  </script>

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>
    <%= title %>
  </title>

  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="stylesheet" href="/assets/styles.css" />

  <script src="/assets/js/basecoat.js?v=0.3.11" defer></script>
  <script src="/assets/js/command.js?v=0.3.11" defer></script>
  <script src="/assets/js/dropdown-menu.js?v=0.3.11" defer></script>
  <script src="/assets/js/popover.js?v=0.3.11" defer></script>
  <script src="/assets/js/select.js?v=0.3.11" defer></script>
  <script src="/assets/js/sidebar.js?v=0.3.11" defer></script>
  <script src="/assets/js/tabs.js?v=0.3.11" defer></script>
  <script src="/assets/js/toast.js?v=0.3.11" defer></script>

  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <style>
    /* Basecard enhancements */
    .premium-card {
      border: 1px solid var(--border) !important;
      background: var(--card) !important;
      color: var(--card-foreground) !important;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03) !important;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }

    .premium-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.06) !important;
    }

    /* Select styling */
    select {
      background-color: var(--card) !important;
      color: var(--foreground) !important;
    }

    select option {
      background-color: var(--card) !important;
      color: var(--foreground) !important;
    }

    .dark select option {
      background-color: #1e293b !important;
      color: #f8fafc !important;
    }

    .dark {
      color-scheme: dark;
    }

    /* Table styling enhancements for visual hierarchy & spacing */
    .questions-table {
      border-collapse: separate !important;
      border-spacing: 0 !important;
      width: 100% !important;
    }
    .questions-table tr {
      transition: background-color 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    .questions-table tbody tr {
      border-bottom: 1px solid var(--border) !important;
    }
    .questions-table tbody tr:hover {
      background-color: rgba(0, 0, 0, 0.015) !important;
    }
    .dark .questions-table tbody tr:hover {
      background-color: rgba(255, 255, 255, 0.01) !important;
    }
    .questions-table th {
      padding: 1rem 1.25rem !important;
      font-weight: 600 !important;
      font-size: 0.75rem !important;
      letter-spacing: 0.05em !important;
      text-transform: uppercase !important;
      color: var(--muted-foreground) !important;
      border-bottom: 1px solid var(--border) !important;
      vertical-align: middle !important;
    }
    .questions-table td {
      padding: 1.5rem 1.25rem !important;
      vertical-align: middle !important;
    }
  </style>
</head>

