          </div>
        </footer>
      </nav>
    </aside>

    <!-- Main Content Area -->
    <main id="content" class="flex-1 flex flex-col min-w-0 bg-muted/20">

      <!-- Topbar Header -->
      <header
        class="bg-background sticky inset-x-0 top-0 isolate flex shrink-0 items-center justify-between border-b z-10 h-14 px-4 gap-4"
        style="z-index: 40;">
        <div class="flex items-center gap-2">
          <button type="button" onclick="document.dispatchEvent(new CustomEvent('basecoat:sidebar'))"
            aria-label="Toggle sidebar"
            class="h-8 w-8 inline-flex items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground md:hidden">
            <i data-lucide="menu" class="size-4"></i>
          </button>
          <h1 class="text-sm font-semibold tracking-tight text-foreground">
            Dashboard Overview
          </h1>
        </div>

        <div class="flex items-center gap-2">

          <button type="button" aria-label="Toggle dark mode"
            onclick="document.dispatchEvent(new CustomEvent('basecoat:theme'))"
            class="h-8 w-8 inline-flex items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
            <i data-lucide="sun" class="size-4 hidden dark:block"></i>
            <i data-lucide="moon" class="size-4 block dark:hidden"></i>
          </button>
        </div>
      </header>

      <!-- Inner Content -->
      <div class="p-6 md:p-8 flex-1 space-y-6">

        <!-- Welcome Hero Card (Stunning Gradient) -->
        <div data-slot="card"
          class="welcome-banner rounded-2xl p-6 relative overflow-hidden flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <!-- Abstract Background shapes (Mockup circles) -->
          <div class="absolute right-0 top-0 bottom-0 w-1/3 opacity-30 pointer-events-none hidden md:block">
            <div class="welcome-circle-1"></div>
            <div class="welcome-circle-2"></div>
            <div class="welcome-circle-3"></div>
          </div>
          <div
            class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.15),transparent_50%)] pointer-events-none">
          </div>

          <div class="relative z-10 max-w-2xl space-y-2">
            <h2 class="text-2xl font-bold tracking-tight mb-2 welcome-title flex items-center gap-2">Selamat Datang,
              Admin FTI! <span class="animate-bounce"></span></h2>
            <p class="text-slate-300 text-xs md:text-sm leading-relaxed welcome-desc">
              Pantau aktivitas survey, kelola data mitra, dan generate PIN kerjasama industri dari satu tempat.
            </p>
          </div>
          <div class="welcome-banner-stats relative z-10 shrink-0 ml-auto">
            <span class="num">
              <%= total_respons %>
            </span>
            <span class="label">Total Aktivitas Bulan Ini</span>
          </div>
        </div>

        <!-- Stats Grid -->
        <div class="dashboard-grid gap-4">

          <!-- Card 1: Total Mitra -->
          <div data-slot="card" class="premium-card rounded-2xl p-6 flex flex-col justify-between gap-5">
            <div class="flex items-start gap-4">
              <div
                class="p-3 bg-indigo-500/10 rounded-2xl text-indigo-600 dark:text-indigo-400 border border-indigo-500/15 shrink-0">
                <i data-lucide="building-2" class="size-5"></i>
              </div>
              <div class="space-y-1">
                <p class="card-title-small">Total Mitra</p>
                <h3 class="text-3xl font-extrabold tracking-tight text-foreground">
                  <%= total_mitra %>
                </h3>
                <span class="trend-badge inline-flex items-center gap-1 mt-0.5">
                  <i data-lucide="trending-up" class="size-3"></i> +3 bulan ini
                </span>
              </div>
            </div>
            <div class="card-divider">
              <div class="flex justify-between items-center text-[10px] font-bold text-muted-foreground">
                <span>Status Mitra Terdaftar</span>
                <span class="text-foreground">Aktif &amp; Terverifikasi</span>
              </div>
              <div class="custom-progress-track">
                <div class="custom-progress-fill indigo" style="width: 100%"></div>
              </div>
            </div>
          </div>

          <!-- Card 2: PIN Aktif -->
          <div data-slot="card" class="premium-card rounded-2xl p-6 flex flex-col justify-between gap-5">
            <div class="flex items-start gap-4">
              <div
                class="p-3 bg-amber-500/10 rounded-2xl text-amber-600 dark:text-amber-400 border border-amber-500/15 shrink-0">
                <i data-lucide="key-round" class="size-5"></i>
              </div>
              <div class="space-y-1">
                <p class="card-title-small">PIN Aktif</p>
                <h3 class="text-3xl font-extrabold tracking-tight text-foreground">
                  <%= total_pin_aktif %>
                </h3>
                <span class="card-subtext block mt-0.5">
                  Belum digunakan mitra
                </span>
              </div>
            </div>
            <div class="card-divider">
              <div class="flex justify-between items-center text-[10px] font-bold text-muted-foreground">
                <span>Dari total PIN</span>
                <span class="text-foreground">
                  <%= total_pin_aktif %> / <%= total_pin %>
                </span>
              </div>
              <div class="custom-progress-track">
                <div class="custom-progress-fill amber"
                  style="width: <%= total_pin > 0 ? Math.min(100, Math.round((total_pin_aktif / total_pin) * 100)) : 0 %>%">
                </div>
              </div>
            </div>
          </div>

          <!-- Card 3: Survey Selesai -->
          <div data-slot="card" class="premium-card rounded-2xl p-6 flex flex-col justify-between gap-5">
            <div class="flex items-start gap-4">
              <div
                class="p-3 bg-emerald-500/10 rounded-2xl text-emerald-600 dark:text-emerald-400 border border-emerald-500/15 shrink-0">
                <i data-lucide="check-circle-2" class="size-5"></i>
              </div>
              <div class="space-y-1">
                <p class="card-title-small">Survey Selesai</p>
                <h3 class="text-3xl font-extrabold tracking-tight text-foreground">
                  <%= total_respons %>
                </h3>
                <span class="card-subtext block mt-0.5">
                  Kuesioner berhasil diisi
                </span>
              </div>
            </div>
            <div class="card-divider">
              <% const rate=total_pin> 0 ? Math.min(100, Math.round((total_respons / total_pin) * 100)) : 0; %>
                <div class="flex justify-between items-center text-[10px] font-bold text-muted-foreground">
                  <span>Rasio Pengisian (Completion Rate)</span>
                  <span class="text-foreground">
                    <%= rate %>% Selesai
                  </span>
                </div>
                <div class="custom-progress-track">
                  <div class="custom-progress-fill emerald" style="width: <%= rate %>%"></div>
                </div>
            </div>
          </div>

        </div>

        <!-- Charts Row -->
        <div class="dashboard-grid gap-6 mt-6">
          
          <!-- Chart Bar -->
          <div data-slot="card" class="premium-card rounded-2xl p-6 flex flex-col gap-4 chart-bar-span">
            <div>
              <h3 class="font-bold text-foreground leading-none tracking-tight text-sm">Tren Survey per Bulan</h3>
              <p class="text-[11px] text-muted-foreground mt-1">Jumlah kuesioner diselesaikan mitra</p>
            </div>
            <div class="relative w-full mt-2 flex-1" style="height: 16rem; min-height: 250px;">
              <canvas id="chartSurveyBar"></canvas>
            </div>
          </div>

          <!-- Chart Donut -->
          <div data-slot="card" class="premium-card rounded-2xl p-6 flex flex-col gap-4">
            <div>
              <h3 class="font-bold text-foreground leading-none tracking-tight text-sm">Distribusi Status PIN</h3>
              <p class="text-[11px] text-muted-foreground mt-1">Proporsi PIN aktif, terpakai, dan kadaluarsa</p>
            </div>
            <div class="donut-row flex gap-6 mt-2" style="height: 16rem;">
              <div class="relative shrink-0" style="height: 11rem; width: 11rem;">
                <canvas id="chartPinDonut"></canvas>
              </div>
              <div class="space-y-2.5 text-xs text-muted-foreground flex flex-col justify-center">
                <div class="flex items-center gap-2.5">
                  <span class="rounded-full block border border-white/10 shadow-xs" style="width: 14px; height: 14px; background-color: #334155;"></span>
                  <span class="font-medium">Aktif: <strong id="l-aktif" class="text-foreground font-bold">0</strong></span>
                </div>
                <div class="flex items-center gap-2.5">
                  <span class="rounded-full block border border-white/10 shadow-xs" style="width: 14px; height: 14px; background-color: #94a3b8;"></span>
                  <span class="font-medium">Terpakai: <strong id="l-terpakai" class="text-foreground font-bold">0</strong></span>
                </div>
                <div class="flex items-center gap-2.5">
                  <span class="rounded-full block border border-white/10 shadow-xs" style="width: 14px; height: 14px; background-color: #e2e8f0;"></span>
                  <span class="font-medium">Kadaluarsa: <strong id="l-kadaluarsa" class="text-foreground font-bold">0</strong></span>
                </div>
              </div>
            </div>
          </div>

        </div>



        <!-- Data Table Card -->
        <div data-slot="card" class="premium-card rounded-2xl overflow-hidden">
          <div class="p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b">
            <div>
              <h3 class="text-lg font-semibold leading-none tracking-tight">Daftar PIN Survey &amp; Mitra</h3>
              <p class="text-xs text-muted-foreground mt-1.5">Kelola token PIN kuesioner industri</p>
            </div>
            <div class="flex flex-wrap gap-2 w-full md:w-auto">
              <label class="relative flex items-center flex-1 md:flex-initial">
                <i data-lucide="search" class="text-muted-foreground"
                  style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); width: 15px; height: 15px; pointer-events: none;"></i>
                <input type="text" id="topbar-search" placeholder="Cari nama mitra..." value="<%= search %>"
                  autocomplete="off" style="padding-left: 36px;"
                  class="h-9 rounded-md border border-border bg-background/60 hover:bg-background/80 focus:bg-background text-sm w-full md:w-60 outline-none focus-visible:ring-1 focus-visible:ring-primary transition-all" />
              </label>
              <a href="/admin/dashboard/export-pdf"
                class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-3 py-2">
                <i data-lucide="printer" class="size-4"></i>
                <span>Laporan PDF</span>
              </a>
              <button id="btn-generate-pin"
                class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-3 py-2">
                <i data-lucide="plus-circle" class="size-4"></i>
                <span>Generate PIN</span>
              </button>
            </div>
          </div>

          <div class="overflow-x-auto w-full">
            <table class="w-full text-sm">
              <thead class="bg-muted/50 border-b">
                <tr class="transition-colors hover:bg-muted/50">
                  <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Perusahaan Mitra</th>
                  <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Kode PIN</th>
                  <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Status</th>
                  <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Dibuat Pada</th>
                  <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Digunakan Pada</th>
                  <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y">
                <% if (locals.perusahaan && perusahaan.length> 0) { %>
                  <% perusahaan.forEach(function(p) { const avatarStr=(p.nama_perusahaan || "NA" ).substring(0,
                    2).toUpperCase(); let formattedDate="—" ; if (p.created_at) { const dateObj=new Date(p.created_at);
                    formattedDate=dateObj.toLocaleDateString('id-ID', { day: '2-digit' , month: 'short' ,
                    year: 'numeric' }); } let formattedUsedDate="—" ; if (p.used_at) { const dateObj=new
                    Date(p.used_at); formattedUsedDate=dateObj.toLocaleDateString('id-ID', { day: '2-digit' ,
                    month: 'short' , year: 'numeric' , hour: '2-digit' , minute:'2-digit' }); } let pillClass='' ; let
                    pinClass='' ; let statusText=p.status_pin || 'active' ; if (statusText==='used' ) {
                    pillClass='bg-slate-500/10 text-slate-500 border-slate-500/20' ;
                    pinClass='line-through text-muted-foreground' ; statusText='Terpakai' ; } else if
                    (statusText==='active' ) { pillClass='bg-emerald-500/10 text-emerald-500 border-emerald-500/20' ;
                    statusText='Aktif' ; } else { pillClass='bg-red-500/10 text-red-500 border-red-500/20' ;
                    statusText='Expired' ; } %>
                    <tr id="row-pin-<%= p.id %>" class="hover:bg-muted/30 transition-colors">
                      <td class="p-4 align-middle font-medium">
                        <div class="flex items-center gap-3">
                          <div
                            class="flex h-9 w-9 items-center justify-center rounded-full bg-muted text-muted-foreground text-xs font-bold">
                            <%= avatarStr %>
                          </div>
                          <div>
                            <div class="text-foreground">
                              <%= p.nama_perusahaan || "Unknown" %>
                            </div>
                            <div class="text-xs text-muted-foreground font-normal">#INV-<%= (p.id ||
                                0).toString().padStart(3, '0' ) %>
                            </div>
                          </div>
                        </div>
                      </td>
                      <td class="p-4 align-middle font-mono font-semibold"><span class="<%= pinClass %>">
                          <%= p.pin_code %>
                        </span></td>
                      <td class="p-4 align-middle">
                        <span
                          class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold <%= pillClass %>">
                          <%= statusText %>
                        </span>
                      </td>
                      <td class="p-4 align-middle text-muted-foreground">
                        <%= formattedDate %>
                      </td>
                      <td class="p-4 align-middle text-muted-foreground">
                        <%= formattedUsedDate %>
                      </td>
                      <td class="p-4 align-middle">
                        <div class="flex items-center gap-2">
                          <button
                            class="btn-reset-pin h-8 w-8 inline-flex items-center justify-center rounded-md border hover:bg-accent hover:text-accent-foreground text-muted-foreground"
                            data-id="<%= p.id %>" data-used="<%= p.status_pin === 'used' ? 1 : 0 %>"
                            title="Reset PIN Status">
                            <i data-lucide="refresh-cw" class="size-3.5"></i>
                          </button>
                          <button
                            class="btn-delete-pin h-8 w-8 inline-flex items-center justify-center rounded-md border border-destructive/20 hover:bg-destructive/10 text-destructive"
                            data-id="<%= p.id %>" title="Hapus PIN">
                            <i data-lucide="trash-2" class="size-3.5"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                    <% }); %>
                      <% } else { %>
                        <tr>
                          <td colspan="6" class="p-8 text-center text-muted-foreground">Belum ada data PIN atau
                            Perusahaan.</td>
                        </tr>
                        <% } %>
              </tbody>
            </table>
          </div>

          <!-- Pagination Footer -->
          <% if (locals.totalPages && totalPages> 1) { %>
            <div class="p-4 flex flex-col sm:flex-row justify-between items-center gap-4 border-t bg-muted/20">
              <div class="text-xs text-muted-foreground">
                Menampilkan halaman <strong>
                  <%= page %>
                </strong> dari <strong>
                  <%= totalPages %>
                </strong> (Total: <%= totalItems %> data)
              </div>
              <div class="flex gap-1" style="display: flex; gap: 4px;">
                <% if (page> 1) { %>
                  <a href="?search=<%= search %>&page=<%= page - 1 %>"
                    style="width: 32px; min-width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;"
                    class="rounded-md border hover:bg-accent hover:text-accent-foreground text-muted-foreground"><i
                      data-lucide="chevron-left" class="size-4"></i></a>
                  <% } else { %>
                    <span
                      style="width: 32px; min-width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;"
                      class="rounded-md border opacity-50 cursor-not-allowed text-muted-foreground"><i
                        data-lucide="chevron-left" class="size-4"></i></span>
                    <% } %>

                      <% for(let i=1; i <=totalPages; i++) { %>
                        <a href="?search=<%= search %>&page=<%= i %>"
                          style="width: 32px; min-width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;"
                          class="rounded-md border text-sm <%= page === i ? 'bg-primary text-primary-foreground font-semibold border-primary' : 'hover:bg-accent hover:text-accent-foreground text-muted-foreground' %>">
                          <%= i %>
                        </a>
                        <% } %>

                          <% if (page < totalPages) { %>
                            <a href="?search=<%= search %>&page=<%= page + 1 %>"
                              style="width: 32px; min-width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;"
                              class="rounded-md border hover:bg-accent hover:text-accent-foreground text-muted-foreground"><i
                                data-lucide="chevron-right" class="size-4"></i></a>
                            <% } else { %>
                              <span
                                style="width: 32px; min-width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;"
                                class="rounded-md border opacity-50 cursor-not-allowed text-muted-foreground"><i
                                  data-lucide="chevron-right" class="size-4"></i></span>
                              <% } %>
              </div>
            </div>
            <% } %>
        </div>

      </div>
    </main>
  </div>

  <!-- Generate PIN Dialog Modal -->
  <dialog id="pin-dialog" class="dialog">
    <div class="!max-w-md w-full">
      <div class="flex items-center gap-2 border-b pb-3">
        <div class="p-2 bg-emerald-500/10 text-emerald-500 rounded-lg">
          <i data-lucide="key-round" class="size-5"></i>
        </div>
        <div>
          <h3 class="text-lg font-semibold leading-none tracking-tight">Generate PIN Baru</h3>
          <p class="text-xs text-muted-foreground mt-1">Buat token akses PIN baru untuk mitra industri.</p>
        </div>
      </div>

      <form id="form-generate-pin" class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium leading-none" for="partner-select">Pilih Mitra Industri</label>
          <select id="partner-select" name="partner_id"
            class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
            required>
            <option value="" disabled selected>-- Silakan Pilih --</option>
            <% if(locals.allPartners) { %>
              <% allPartners.forEach(function(p) { %>
                <option value="<%= p.id %>">
                  <%= p.name %>
                </option>
                <% }) %>
                  <% } %>
          </select>
        </div>

        <div id="pin-alert" class="text-xs text-destructive min-h-[1rem]"></div>

        <div class="flex justify-end gap-2 border-t pt-3">
          <button type="button" id="btn-close-dialog"
            class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
            Batal
          </button>
          <button type="submit"
            class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2">
            Generate PIN
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <script>
    lucide.createIcons();

    // Search field handler
    document.getElementById('topbar-search').addEventListener('keypress', function (e) {
      if (e.key === 'Enter') {
        window.location.href = '?search=' + encodeURIComponent(this.value);
      }
    });



    // Dialog controls
    const pinDialog = document.getElementById('pin-dialog');
    const btnGeneratePin = document.getElementById('btn-generate-pin');
    const btnCloseDialog = document.getElementById('btn-close-dialog');
    const formGeneratePin = document.getElementById('form-generate-pin');
    const pinAlert = document.getElementById('pin-alert');

    btnGeneratePin.addEventListener('click', () => {
      pinDialog.showModal();
      pinAlert.innerText = '';
    });

    btnCloseDialog.addEventListener('click', () => {
      pinDialog.close();
    });

    formGeneratePin.addEventListener('submit', (e) => {
      e.preventDefault();
      pinAlert.innerText = '';
      const partnerId = document.getElementById('partner-select').value;

      fetch('/admin/generate-pin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ partner_id: partnerId })
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            pinDialog.close();
            Swal.fire({
              title: 'Berhasil!',
              text: 'PIN Baru: ' + data.pin_code,
              icon: 'success',
              confirmButtonText: 'Tutup'
            }).then(() => {
              window.location.reload();
            });
          } else {
            pinAlert.innerText = data.message || 'Gagal generate PIN';
          }
        })
        .catch(err => {
          pinAlert.innerText = 'Terjadi kesalahan sistem.';
        });
    });

    // Actions
    document.querySelectorAll('.btn-reset-pin').forEach(btn => {
      btn.addEventListener('click', function () {
        const id = this.getAttribute('data-id');
        const currentlyUsed = parseInt(this.getAttribute('data-used'));
        const nextUsed = currentlyUsed === 1 ? 0 : 1;
        const nextStatusName = nextUsed === 1 ? 'Terpakai' : 'Aktif';

        Swal.fire({
          title: 'Konfirmasi Reset',
          text: `Apakah Anda yakin ingin me-reset status PIN ini menjadi ${nextStatusName}?`,
          icon: 'question',
          showCancelButton: true,
          confirmButtonText: 'Ya, Reset!',
          cancelButtonText: 'Batal'
        }).then((result) => {
          if (result.isConfirmed) {
            fetch(`/api/pin-logs/${id}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ is_used: nextUsed })
            })
              .then(res => res.json())
              .then(data => {
                if (data.success) {
                  Swal.fire('Berhasil!', 'Status PIN berhasil diperbarui.', 'success').then(() => {
                    window.location.reload();
                  });
                } else {
                  Swal.fire('Gagal!', 'Gagal memperbarui PIN: ' + data.message, 'error');
                }
              })
              .catch(err => Swal.fire('Error!', 'Gagal memproses request.', 'error'));
          }
        });
      });
    });

    document.querySelectorAll('.btn-delete-pin').forEach(btn => {
      btn.addEventListener('click', function () {
        const id = this.getAttribute('data-id');
        Swal.fire({
          title: 'Hapus PIN?',
          text: 'Apakah Anda yakin ingin menghapus PIN ini secara permanen dari database?',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#ef4444',
          confirmButtonText: 'Ya, Hapus!',
          cancelButtonText: 'Batal'
        }).then((result) => {
          if (result.isConfirmed) {
            fetch(`/api/pin-logs/${id}`, {
              method: 'DELETE'
            })
              .then(res => res.json())
              .then(data => {
                if (data.success) {
                  Swal.fire('Terhapus!', 'PIN berhasil dihapus.', 'success');
                  document.getElementById(`row-pin-${id}`).remove();
                } else {
                  Swal.fire('Gagal!', 'Gagal menghapus PIN: ' + data.message, 'error');
                }
              })
              .catch(err => Swal.fire('Error!', 'Gagal memproses request.', 'error'));
          }
        });
      });
    });

    // Chart.js Configuration
    if(typeof Chart !== 'undefined') {
      Chart.defaults.font.family = "system-ui, -apple-system, sans-serif";

      // Bar Chart: Tren Survey per Bulan
      const ctxBar = document.getElementById('chartSurveyBar').getContext('2d');
      const isDark = document.documentElement.classList.contains('dark');
      const gridColor = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.04)';
      const textColor = isDark ? '#a1a1aa' : '#64748b';

      const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Ags', 'Sep', 'Okt', 'Nov', 'Des'];
      const dynamicLabels = [];
      const currentMonth = new Date().getMonth();
      for (let i = 0; i < 6; i++) {
        let m = (currentMonth + i) % 12;
        dynamicLabels.push(monthNames[m]);
      }

      new Chart(ctxBar, {
        type: 'bar',
        data: {
          labels: dynamicLabels,
          datasets: [{
            label: 'Survey Selesai',
            data: [<%= total_respons %>, 0, 0, 0, 0, 0],
            backgroundColor: '#0f172a',
            borderRadius: 6,
          }, {
            label: 'PIN Digenerate',
            data: [<%= total_pin_aktif + total_respons %>, 0, 0, 0, 0, 0],
            backgroundColor: '#94a3b8',
            borderRadius: 6,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'top', labels: { boxWidth: 12, usePointStyle: true, font: { size: 11 }, color: textColor } }
          },
          scales: {
            x: { grid: { display: false }, ticks: { color: textColor, font: { size: 11 } } },
            y: { grid: { color: gridColor }, ticks: { stepSize: 2, color: textColor, font: { size: 11 } }, beginAtZero: true }
          }
        }
      });

      // Donut Chart: Status PIN
      let pinDonutChart = null;

      function renderDonutChart(active, used, expired) {
        const ctxDonut = document.getElementById('chartPinDonut').getContext('2d');
        if (pinDonutChart) pinDonutChart.destroy();

        const isDark = document.documentElement.classList.contains('dark');

        pinDonutChart = new Chart(ctxDonut, {
          type: 'doughnut',
          data: {
            labels: ['Aktif', 'Terpakai', 'Kadaluarsa'],
            datasets: [{
              data: [active, used, expired],
              backgroundColor: ['#334155', '#94a3b8', isDark ? '#27272a' : '#f1f5f9'],
              borderWidth: 0,
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '75%',
            plugins: {
              legend: { display: false }
            }
          }
        });

        document.getElementById('l-aktif').innerText = active;
        document.getElementById('l-terpakai').innerText = used;
        document.getElementById('l-kadaluarsa').innerText = expired;
      }

      function fetchDashboardStats() {
        fetch('/api/dashboard-stats')
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              const stats = data.data;
              if (stats.pin_stats) {
                renderDonutChart(stats.pin_stats.active || 0, stats.pin_stats.used || 0, stats.pin_stats.expired || 0);
              } else {
                renderDonutChart(0, 0, 0);
              }
            }
          })
          .catch(err => console.error('Error fetching dashboard stats:', err));
      }

      fetchDashboardStats();
    }
  </script>
</body>

</html>