<!doctype html>
<html lang="id">
  <head>
    <script>
      (() => {
        try {
          localStorage.removeItem("themeVariant");
        } catch (_) {}
        try {
          const stored = localStorage.getItem("themeMode");
          if (
            stored
              ? stored === "dark"
              : matchMedia("(prefers-color-scheme: dark)").matches
          ) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}

        const apply = (dark) => {
          document.documentElement.classList.toggle("dark", dark);
          try {
            localStorage.setItem("themeMode", dark ? "dark" : "light");
          } catch (_) {}
        };

        document.addEventListener("basecoat:theme", (event) => {
          const mode = event.detail?.mode;
          apply(
            mode === "dark"
              ? true
              : mode === "light"
                ? false
                : !document.documentElement.classList.contains("dark"),
          );
        });
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <meta name="description" content="Login ke SUKAFTI — Sistem Informasi Survey Kerja Sama FTI Universitas Andalas." />

    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="stylesheet" href="/assets/styles.css" />

    <script src="/assets/js/basecoat.js?v=0.3.11" defer></script>
    <script src="/assets/js/command.js?v=0.3.11" defer></script>
    <script src="/assets/js/dropdown-menu.js?v=0.3.11" defer></script>
    <script src="/assets/js/popover.js?v=0.3.11" defer></script>
    <script src="/assets/js/select.js?v=0.3.11" defer></script>
    <script src="/assets/js/sidebar.js?v=0.3.11" defer></script>
    <script src="/assets/js/tabs.js?v=0.3.11" defer></script>
    <script src="/assets/js/toast.js?v=0.3.11" defer></script>

    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

    <style>
      /* Simple styling for OTP inputs in Basecoat theme */
      .pin-box-container {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        margin: 1rem 0;
      }
      .pin-box {
        width: 3rem;
        height: 3rem;
        text-align: center;
        font-size: 1.5rem;
        font-weight: 700;
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        background-color: transparent;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
      }
      .pin-box:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.05);
      }
      .dark .pin-box:focus {
        box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.15);
      }
    </style>
  </head>
  <body class="bg-background">
    <div class="flex min-h-svh flex-col items-center justify-center bg-muted p-6 md:p-10">
      <div class="w-full max-w-sm md:max-w-4xl">
        <div class="flex flex-col gap-6">
          <div data-slot="card" class="flex flex-col gap-6 rounded-xl border bg-card text-card-foreground shadow-sm overflow-hidden p-0">
            <div data-slot="card-content" class="grid p-0 md:grid-cols-2">
              
              <% if (activeTab === 'admin') { %>
                <!-- Form Admin -->
                <form class="p-6 md:p-8 flex flex-col justify-between" action="/login" method="POST">
                  <div data-slot="field-group" class="flex w-full flex-col gap-6">
                    <div class="flex flex-col items-center gap-2 text-center">
                      <div class="flex flex-col items-center gap-1 mb-2">
                        <div class="flex items-center gap-2">
                          <img src="/image/fti%20logo.jpg" alt="Logo FTI" class="h-10 w-auto rounded-md object-contain" />
                          <span class="text-xl font-bold tracking-tight">SUKAFTI</span>
                        </div>
                        <span class="text-xs text-muted-foreground font-medium">Survey Kerjasama FTI</span>
                      </div>
                      <h1 class="text-2xl font-bold text-foreground">Masuk Admin</h1>
                      <p class="text-sm text-muted-foreground">
                        Login sebagai Administrator SUKAFTI
                      </p>
                    </div>

                    <% if (locals.error && error) { %>
                      <div class="bg-destructive/15 text-destructive text-sm p-3 rounded-md border border-destructive/20 text-center flex items-center gap-2 justify-center">
                        <i data-lucide="alert-circle" class="size-4 shrink-0"></i>
                        <span><%= error %></span>
                      </div>
                    <% } %>

                    <div role="group" data-slot="field" data-orientation="vertical" class="group/field flex w-full gap-2 flex-col">
                      <label data-slot="field-label" class="text-sm font-medium leading-none" for="admin-email">Email / Username</label>
                      <input type="text" name="email" id="admin-email" data-slot="input" class="h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs transition-colors placeholder:text-muted-foreground outline-none focus-visible:border-ring focus-visible:ring-1 focus-visible:ring-ring" placeholder="Masukkan Email atau Username" required />
                    </div>

                    <div role="group" data-slot="field" data-orientation="vertical" class="group/field flex w-full gap-2 flex-col">
                      <div class="flex items-center justify-between">
                        <label data-slot="field-label" class="text-sm font-medium leading-none" for="admin-password">Password</label>
                      </div>
                      <div class="relative">
                        <input type="password" name="password" id="admin-password" data-slot="input" class="h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 pr-10 text-sm shadow-xs transition-colors placeholder:text-muted-foreground outline-none focus-visible:border-ring focus-visible:ring-1 focus-visible:ring-ring" required />
                        <button type="button" class="absolute inset-y-0 right-0 flex items-center pr-3 text-muted-foreground hover:text-foreground" onclick="togglePasswordVisibility()">
                          <span id="icon-show"><i data-lucide="eye" class="size-4"></i></span>
                          <span id="icon-hide" class="hidden"><i data-lucide="eye-off" class="size-4"></i></span>
                        </button>
                      </div>
                    </div>

                    <button data-slot="button" data-variant="default" data-size="default" class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2" type="submit">
                      <i data-lucide="log-in" class="size-4"></i>
                      Masuk sebagai Admin
                    </button>
                  </div>

                  <div class="mt-6 border-t pt-4 text-center">
                    <p class="text-sm text-muted-foreground">
                      Bukan Admin? 
                      <a href="/login-mitra" class="underline underline-offset-4 hover:text-primary">Masuk sebagai Mitra</a>
                    </p>
                  </div>
                </form>
              <% } else { %>
                <!-- Form Mitra -->
                <form class="p-6 md:p-8 flex flex-col justify-between" action="/api/auth/mitra-login" method="POST">
                  <div data-slot="field-group" class="flex w-full flex-col gap-6">
                    <div class="flex flex-col items-center gap-2 text-center">
                      <div class="flex flex-col items-center gap-1 mb-2">
                        <div class="flex items-center gap-2">
                          <img src="/image/fti%20logo.jpg" alt="Logo FTI" class="h-10 w-auto rounded-md object-contain" />
                          <span class="text-xl font-bold tracking-tight">SUKAFTI</span>
                        </div>
                        <span class="text-xs text-muted-foreground font-medium">Survey Kerjasama FTI</span>
                      </div>
                      <h1 class="text-2xl font-bold text-foreground">Masuk Mitra</h1>
                      <p class="text-sm text-muted-foreground">
                        Sistem Informasi Survey Kerja Sama FTI
                      </p>
                    </div>

                    <% if (locals.error && error) { %>
                      <div class="bg-destructive/15 text-destructive text-sm p-3 rounded-md border border-destructive/20 text-center flex items-center gap-2 justify-center">
                        <i data-lucide="alert-circle" class="size-4 shrink-0"></i>
                        <span><%= error %></span>
                      </div>
                    <% } %>

                    <div class="text-center px-2">
                      <p class="text-sm text-muted-foreground">
                        Masukkan 6 digit PIN perusahaan Anda untuk mengisi survey kerjasama.
                      </p>
                    </div>

                    <div role="group" data-slot="field" class="flex flex-col gap-2">
                      <input type="hidden" name="pin" id="mitra-pin-hidden" />
                      <div class="pin-box-container">
                        <input type="text" class="pin-box" maxlength="1" autocomplete="off" required />
                        <input type="text" class="pin-box" maxlength="1" autocomplete="off" />
                        <input type="text" class="pin-box" maxlength="1" autocomplete="off" />
                        <input type="text" class="pin-box" maxlength="1" autocomplete="off" />
                        <input type="text" class="pin-box" maxlength="1" autocomplete="off" />
                        <input type="text" class="pin-box" maxlength="1" autocomplete="off" />
                      </div>
                      <p class="text-xs text-muted-foreground text-center">
                        PIN diberikan oleh administrator SUKAFTI dan hanya dapat digunakan satu kali.
                      </p>
                    </div>

                    <button data-slot="button" data-variant="default" data-size="default" class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2" type="submit" id="btn-mitra-login">
                      <i data-lucide="arrow-right-circle" class="size-4"></i>
                      Masuk ke Sistem
                    </button>
                  </div>

                  <div class="mt-6 border-t pt-4 text-center">
                    <p class="text-sm text-muted-foreground">
                      Bukan Mitra? 
                      <a href="/login" class="underline underline-offset-4 hover:text-primary">Masuk sebagai Admin</a>
                    </p>
                  </div>
                </form>
              <% } %>

              <!-- Right Panel Illustration -->
              <div class="relative hidden bg-muted md:flex flex-col items-center justify-center p-8 border-l">
                <div class="max-w-md text-center flex flex-col items-center justify-center gap-6">
                  <img src="/image/survey_illustration.png" alt="Illustration" class="max-h-60 object-contain dark:brightness-[0.8] dark:grayscale-[0.2]" />
                  <div>
                    <h2 class="text-lg font-semibold text-foreground">Sinergi Akademik &amp; Industri</h2>
                    <p class="text-sm text-muted-foreground mt-2">
                      Partisipasi Anda sangat berarti untuk meningkatkan kualitas lulusan dan layanan Fakultas Teknologi Informasi Universitas Andalas.
                    </p>
                  </div>
                </div>
              </div>

            </div>
          </div>
          <p class="text-xs text-muted-foreground text-center">
            &copy; <%= new Date().getFullYear() %> SUKAFTI &mdash; Fakultas Teknologi Informasi Universitas Andalas.
          </p>
        </div>
      </div>
    </div>
    <div id="toaster" class="toaster"></div>

    <script>
      lucide.createIcons();

      // Password Visibility Toggle
      function togglePasswordVisibility() {
        const passwordInput = document.getElementById('admin-password');
        const iconShow = document.getElementById('icon-show');
        const iconHide = document.getElementById('icon-hide');
        
        if (passwordInput.type === 'password') {
          passwordInput.type = 'text';
          iconShow.classList.add('hidden');
          iconHide.classList.remove('hidden');
        } else {
          passwordInput.type = 'password';
          iconShow.classList.remove('hidden');
          iconHide.classList.add('hidden');
        }
      }

      // OTP PIN Logic
      const pinBoxes = document.querySelectorAll('.pin-box');
      const hiddenPinInput = document.getElementById('mitra-pin-hidden');

      if (pinBoxes.length > 0) {
        pinBoxes[0].focus();
        pinBoxes.forEach((box, index) => {
          box.addEventListener('input', (e) => {
            let val = e.target.value.toUpperCase();
            e.target.value = val;
            updateHiddenPin();

            if (val && index < pinBoxes.length - 1) {
              pinBoxes[index + 1].focus();
            }
          });

          box.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !e.target.value && index > 0) {
              pinBoxes[index - 1].focus();
              pinBoxes[index - 1].value = '';
              updateHiddenPin();
            }
          });

          box.addEventListener('paste', (e) => {
            e.preventDefault();
            let pasteData = (e.clipboardData || window.clipboardData).getData('text').toUpperCase().replace(/[^A-Z0-9]/g, '');
            for (let i = 0; i < pasteData.length; i++) {
              if (index + i < pinBoxes.length) {
                pinBoxes[index + i].value = pasteData[i];
              }
            }
            if (index + pasteData.length < pinBoxes.length) {
              pinBoxes[index + pasteData.length].focus();
            } else {
              pinBoxes[pinBoxes.length - 1].focus();
            }
            updateHiddenPin();
            if (hiddenPinInput.value.length === 6) {
              document.querySelector('#btn-mitra-login').focus();
            }
          });
        });

        function updateHiddenPin() {
          let fullPin = '';
          pinBoxes.forEach(b => fullPin += b.value);
          hiddenPinInput.value = fullPin;
        }
      }
    </script>
  </body>
</html>
