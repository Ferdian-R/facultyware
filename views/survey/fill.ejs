<!doctype html>
<html lang="id">

<head>
  <script>
    (() => {
      try {
        localStorage.removeItem("themeVariant");
      } catch (_) {}
      try {
        const stored = localStorage.getItem("themeMode");
        if (
          stored
            ? stored === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches
        ) {
          document.documentElement.classList.add("dark");
        }
      } catch (_) { }

      const apply = (dark) => {
        document.documentElement.classList.toggle("dark", dark);
        try {
          localStorage.setItem("themeMode", dark ? "dark" : "light");
        } catch (_) { }
      };

      document.addEventListener("basecoat:theme", (event) => {
        const mode = event.detail?.mode;
        apply(
          mode === "dark"
            ? true
            : mode === "light"
              ? false
              : !document.documentElement.classList.contains("dark"),
        );
      });
    })();
  </script>

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>
    <%= title %>
  </title>
  <meta name="description" content="Portal Pengisian Survei Kepuasan Mitra Kerja Sama FTI Universitas Andalas." />

  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="stylesheet" href="/assets/styles.css" />

  <script src="/assets/js/basecoat.js?v=0.3.11" defer></script>
  <script src="/assets/js/command.js?v=0.3.11" defer></script>
  <script src="/assets/js/dropdown-menu.js?v=0.3.11" defer></script>
  <script src="/assets/js/popover.js?v=0.3.11" defer></script>
  <script src="/assets/js/select.js?v=0.3.11" defer></script>
  <script src="/assets/js/sidebar.js?v=0.3.11" defer></script>
  <script src="/assets/js/tabs.js?v=0.3.11" defer></script>
  <script src="/assets/js/toast.js?v=0.3.11" defer></script>

  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <style>
    /* Premium banner styles using Basecoat variables */
    .welcome-banner {
      background: linear-gradient(135deg, #1e293b 0%, #111827 50%, #0f172a 100%) !important;
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
    }
    .dark .welcome-banner {
      background: linear-gradient(135deg, #0f172a 0%, #030712 100%) !important;
      border-color: rgba(255, 255, 255, 0.08) !important;
    }
    .welcome-title {
      color: #ffffff !important;
      font-weight: 700;
    }
    .welcome-desc {
      color: #cbd5e1 !important;
      opacity: 0.95;
    }
    .dark .welcome-desc {
      color: #cbd5e1 !important;
    }

    /* Basecard enhancements */
    .premium-card {
      border: 1px solid var(--border) !important;
      background: var(--card) !important;
      color: var(--card-foreground) !important;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03) !important;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    .premium-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.06) !important;
    }

    /* Beautiful rating scales */
    .rating-btn {
      display: flex;
      height: 3rem;
      width: 3rem;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      border: 1px solid var(--border);
      background-color: var(--card);
      font-weight: 700;
      color: var(--muted-foreground);
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
    }
    .rating-btn:hover {
      border-color: var(--primary);
      transform: scale(1.05);
      color: var(--foreground);
    }
    /* Hide native radio, style active custom design */
    input[type="radio"]:checked + .rating-btn {
      background-color: var(--primary) !important;
      color: var(--primary-foreground) !important;
      border-color: var(--primary) !important;
      box-shadow: 0 0 12px rgba(99, 102, 241, 0.4) !important;
    }
  </style>
</head>

<body class="bg-muted/30">
  <div class="max-w-3xl mx-auto px-4 py-8 md:py-12 space-y-6">

    <!-- Top header bar for survey client -->
    <header class="flex items-center justify-between border rounded-lg bg-card text-card-foreground shadow-sm p-4">
      <div class="flex items-center gap-2">
        <img src="/image/fti%20logo.jpg" alt="Logo FTI" class="h-8 w-8 rounded-lg object-contain bg-white p-0.5 border" />
        <span class="text-sm font-semibold tracking-tight text-foreground">SUKAFTI Portal</span>
      </div>
      <button type="button" aria-label="Toggle dark mode"
        onclick="document.dispatchEvent(new CustomEvent('basecoat:theme'))"
        class="h-8 w-8 inline-flex items-center justify-center rounded-md border hover:bg-accent hover:text-accent-foreground bg-background">
        <i data-lucide="sun" class="size-4 hidden dark:block"></i>
        <i data-lucide="moon" class="size-4 block dark:hidden"></i>
      </button>
    </header>

    <!-- Main Header Banner Card -->
    <div data-slot="card"
      class="welcome-banner rounded-2xl p-6 relative overflow-hidden">
      <div class="relative z-10 space-y-3">
        <span
          class="inline-flex items-center gap-1 rounded-full bg-white/10 border border-white/10 px-2.5 py-0.5 text-xs font-semibold" style="color: #ffffff !important;">
          <i data-lucide="building-2" class="size-3.5"></i>
          <%= partnerName %>
        </span>
        <h1 class="text-2xl font-bold tracking-tight welcome-title">
          <%= survey.title %>
        </h1>
        <p class="text-xs text-slate-300 leading-relaxed max-w-2xl welcome-desc">
          <%= survey.description
            || "Silakan luangkan waktu sejenak untuk mengisi survei evaluasi kerja sama ini. Tanggapan Anda sangat berharga bagi peningkatan layanan akademik dan kolaborasi industri FTI."
            %>
        </p>
      </div>
    </div>

    <!-- Error Alerts -->
    <% if (error) { %>
      <div
        class="bg-destructive/15 text-destructive text-sm p-4 rounded-md border border-destructive/20 flex items-center gap-2">
        <i data-lucide="alert-circle" class="size-4 shrink-0"></i>
        <span>
          <%= error %>
        </span>
      </div>
      <% } %>

        <!-- Progress Tracking Component -->
        <div data-slot="card" class="premium-card rounded-2xl p-4 flex flex-col gap-3">
          <div class="flex justify-between items-center text-xs font-semibold text-muted-foreground">
            <span>Progress Pengisian</span>
            <span id="progress-text">0% Selesai (0 / <%= questions.length %> Pertanyaan)</span>
          </div>
          <div data-slot="progress" class="relative h-2.5 w-full overflow-hidden rounded-full bg-secondary">
            <div class="h-full bg-primary transition-all duration-300 rounded-full" id="progress-fill"
              style="width: 0%"></div>
          </div>
        </div>

        <!-- Questionnaire Form -->
        <form action="/survey-mitra/submit" method="POST" id="survey-form" class="space-y-6">

          <% questions.forEach(function(q, index) { %>
            <div data-slot="card"
              class="premium-card rounded-2xl p-6 flex flex-col gap-4"
              id="card-q-<%= q.id %>">
              <div class="flex items-center gap-2">
                <span
                  class="flex h-6 w-6 items-center justify-center rounded-md bg-muted text-muted-foreground text-xs font-bold">
                  <%= index + 1 %>
                </span>
                <h2 class="text-sm font-semibold tracking-tight text-foreground leading-relaxed">
                  <%= q.question_text %>
                </h2>
              </div>

              <div class="w-full">
                <% if (q.type==='single_choice' && q.options[0] && q.options[0].score !== undefined && (q.options[0].score === 1 || q.options[0].score === '1') && q.options.length === 5 && q.options[0].option_text.includes('Buruk')) { %>
                  <!-- Rating Skala (1-5) using pure Tailwind styles for Question 1 -->
                  <div class="flex flex-wrap justify-between gap-4 mt-2">
                    <% q.options.forEach(function(opt) { %>
                      <label class="flex flex-col items-center gap-2 cursor-pointer flex-1 min-w-[70px]">
                        <input type="radio" name="question_<%= q.id %>" value="<%= opt.id %>" class="peer sr-only"
                          required />
                        <span class="rating-btn">
                          <%= opt.score %>
                        </span>
                        <span
                          class="text-[10px] text-muted-foreground font-medium text-center max-w-[90px] leading-tight peer-checked:text-foreground peer-checked:font-semibold">
                          <%= opt.option_text %>
                        </span>
                      </label>
                      <% }) %>
                  </div>
                  <% } else if (q.type==='multiple_choice' || q.type==='single_choice') { %>
                    <!-- Multiple Choice & Single Choice radio buttons -->
                    <div class="flex flex-col gap-2.5 mt-2">
                      <% q.options.forEach(function(opt) { %>
                        <label
                          class="flex items-center gap-3 rounded-lg border bg-background p-3 cursor-pointer hover:bg-muted/40 transition-colors border-input">
                          <input type="radio" name="question_<%= q.id %>" value="<%= opt.id %>"
                            class="h-4 w-4 rounded-full border-input text-primary focus:ring-ring" required />
                          <span class="text-xs font-medium text-foreground leading-tight">
                            <%= opt.option_text %>
                          </span>
                        </label>
                        <% }) %>
                    </div>
                    <% } else if (q.type==='text' ) { %>
                      <!-- Qualitative text area -->
                      <textarea name="question_<%= q.id %>"
                        class="flex min-h-[100px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-xs shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring mt-2"
                        placeholder="Tuliskan jawaban deskriptif Anda secara lengkap..." required></textarea>
                      <% } %>
              </div>
            </div>
            <% }) %>

              <!-- Submit & Navigation Panel -->
              <div class="flex items-center justify-between border-t pt-6 mt-8">
                <a href="/logout"
                  class="inline-flex items-center justify-center gap-1.5 rounded-md text-xs font-semibold border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
                  <i data-lucide="log-out" class="size-4"></i>
                  <span>Keluar</span>
                </a>
                <button type="submit"
                  class="inline-flex items-center justify-center gap-1.5 rounded-md text-xs font-semibold bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2">
                  <span>Kirim Jawaban</span>
                  <i data-lucide="send" class="size-3.5"></i>
                </button>
              </div>
        </form>

  </div>

  <script>
    lucide.createIcons();

    const totalQuestions = <%= questions.length %>;
    const form = document.getElementById('survey-form');
    const progressFill = document.getElementById('progress-fill');
    const progressText = document.getElementById('progress-text');

    function calculateProgress() {
      let answeredCount = 0;
      const answeredSet = new Set();

      const checkedRadios = form.querySelectorAll('input[type="radio"]:checked');
      checkedRadios.forEach(radio => {
        answeredSet.add(radio.getAttribute('name'));
      });

      const textareas = form.querySelectorAll('textarea');
      textareas.forEach(ta => {
        if (ta.value.trim().length > 0) {
          answeredSet.add(ta.getAttribute('name'));
        }
      });

      answeredCount = answeredSet.size;
      const percentage = Math.round((answeredCount / totalQuestions) * 100);

      progressFill.style.width = percentage + '%';
      progressText.innerText = `${percentage}% Selesai (${answeredCount} / ${totalQuestions} Pertanyaan)`;
    }

    form.querySelectorAll('input[type="radio"]').forEach(radio => {
      radio.addEventListener('change', calculateProgress);
    });

    form.querySelectorAll('textarea').forEach(ta => {
      ta.addEventListener('input', calculateProgress);
    });

    calculateProgress();
  </script>
</body>

</html>